yso:p18069 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2003-03-05"^^xsd:date ;
    skos:altLabel "gamba"@fi,
        "gamba"@sv ;
    skos:broader yso:p14229 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85143457>,
        allars:Y28903,
        ysa:Y123707 ;
    skos:definition "Otenauhallinen yleensä kuusi- tai seitsemänkielinen varsinkin renessanssin ja barokin aikana käytetty jousisoitin, jota valmistettiin eri kokoina. Varsinkin Englannissa eri korkuiset viola da gambat soittivat yhdessä ns. consort-musiikkia."@fi,
        "Stränginstrument med vanligen sex eller sju strängar, tillverkat i olika storlekar, använt särskilt under renässansen och barocken."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "viola da gamba"@en,
        "viola da gamba"@fi,
        "viola da gamba"@sv ;
    skos:related yso:p18070 .

yso:p18070 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:altLabel "cello"@sv ;
    skos:broader yso:p14229 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85143658>,
        allars:Y28905,
        ysa:Y101960 ;
    skos:definition "Viuluperheen toiseksi matalaäänisin soitin. Sello muistuttaa kontrabassoa ja sitä soitetaan kontrabasson tavoin pystysuunnassa, mutta on pienempi ja soi oktaavia korkeammalta."@fi,
        "Basinstrument i violinfamiljen. Cellon påminner om kontrabas och den spelas på samma sätt i vertikal ställning, men är mindre och ljuder en oktav högre."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "cello"@en,
        "sello"@fi,
        "violoncell"@sv ;
    skos:related yso:p18069 .

