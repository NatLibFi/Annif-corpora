yso:p29869 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2017-07-11"^^xsd:date ;
    skos:altLabel "minstrelartister"@sv ;
    skos:broadMatch <http://id.loc.gov/authorities/subjects/sh86002417> ;
    skos:broader yso:p5329 ;
    skos:closeMatch allars:Y52078,
        ysa:Y214789 ;
    skos:definition "Yhdysvalloissa 1800-luvulla suosittu viihdemuoto minstrel show oli laulua, tanssia ja teatteria yhdistävä esitys, jossa perinteisesti karrikoitiin mustien ulkonäköä, tanssia ja laulua. Yleensä minstrel show -esiintyjät olivat valkoisia viihdetaiteilijoita, jotka maalasivat kasvonsa mustiksi."@fi,
        "Minstrel show var i 1800-talets USA en populär underhållningsform som utgjordes av en kombination av sång, dans och teater och som karikerade svartas utseende, dans och sång. Minstrel show-artisterna var vanligen vita underhållningsartister som målade sina ansikten svarta."@sv ;
    skos:hiddenLabel "minstrel show performer"@en,
        "minstrel show -esiintyjä"@fi,
        "minstrel show-artist"@sv,
        "minstrelartist"@sv ;
    skos:inScheme kauno: ;
    skos:note "Termin lisäksi on syytä käyttää maantieteellisiä ja ajallisia täsmenteitä."@fi ;
    skos:prefLabel "minstrel show performers"@en,
        "minstrel show -esiintyjät"@fi,
        "minstrel show-artister"@sv ;
