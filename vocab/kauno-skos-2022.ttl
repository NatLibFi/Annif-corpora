yso:p1160 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Mediasanasto"@fi ;
    dct:created "2000-02-14"^^xsd:date ;
    skos:altLabel "kansalaisjournalismi (ammattimedia)"@fi,
        "deltagande journalistik"@sv,
        "medborgarjournalistik (professionella medier)"@sv ;
    skos:broader yso:p1161 ;
    skos:closeMatch allars:Y22585,
        ysa:Y112733 ;
    skos:inScheme kauno: ;
    skos:note "Yhdysvalloissa 1990-luvulla syntynyt journalistinen suuntaus, joka painottaa erityisesti sanomalehdistön paikallisjournalistista tehtävää toimia aktiivisena yhteiskunnallisen keskustelun synnyttäjänä ja foorumina. Median tulee raportoida yhteisöllisistä ongelmista ja sen tulee toimia aktiivisesti niiden ratkaisemiseksi."@fi,
        "Inriktning inom journalistiken utvecklad i USA på 1990-talet, där speciell hänsyn läggs vid att journalisten aktivt tar del i samhällsfrågor på gräsrotsnivå. Journalisten skall inte enbart rapportera utan aktivt diskutera och hjälpa läsaren att hitta fram till sina egna lösningar och till sin egen övertygelse."@sv ;
    skos:prefLabel "civic journalism"@en,
        "osallistava journalismi"@fi,
        "deltagarjournalistik"@sv .

