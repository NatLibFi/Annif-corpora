        yso:p5397,
        yso:p6026,
        yso:p605,
        yso:p690,
        yso:p9342,
        yso:p9640 ;
    skos:note "Ideas which often take a physical form. The content, however, takes precedence over the physical object as it is the prerequisite of physical manifestation."@en,
        "This is a hierarchical concept not to be used in subject cataloging."@en,
        "Ajatussisältö, joka usein saa myös fyysisen muodon; sisältö on kuitenkin fyysistä objektia tärkeämpi ja fyysisen muodon edellytys."@fi,
        "Käsite on tyypiltään hierarkisoiva. Käsitettä ei ole tarkoitettu käytettäväksi kuvailussa."@fi,
        "Begreppstypen är hierarkiserande. Begreppet är inte avsett för användning vid innehållsbeskrivning."@sv,
        "Tankeinnehåll som ofta får även en fysisk form; innehållet är ändå viktigare än det fysiska objektet och är den fysiska formens förutsättning."@sv ;
    skos:prefLabel "abstract objects"@en,
        "abstraktit objektit"@fi,
        "abstrakta objekt"@sv ;
    yso-meta:singularAltLabel "intellectual accomplishment"@en,
        "henkinen tuotos"@fi,
        "mental produkt"@sv ;
    yso-meta:singularPrefLabel "abstract object"@en,
        "abstrakti objekti"@fi,
        "abstrakt objekt"@sv .

