        "developmental language disorder"@en,
        "SLI"@fi,
        "dysfasia"@fi,
        "kielen kehityksen erityisvaikeus"@fi,
        "kielenkehityksen erityisvaikeus"@fi,
        "dysfasi"@sv,
        "primär språkstörning"@sv,
        "specifik störning i tal- och språkutvecklingen"@sv ;
    skos:broader yso:p12074,
        yso:p20987 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh00002036>,
        allars:Y33117,
        ysa:Y133143 ;
    skos:inScheme kauno: ;
    skos:note "Kielellisessä erityisvaikeudessa (SLI, aiemmin dysfasia) lapsen puheen ja kielen kehitys viivästyy tai etenee poikkeavasti ja puheilmaisu ja/tai kuullun puheen ymmärtäminen on jonkin verran tai huomattavan vaikeaa. Se on häiriö, jossa lapsen kielellinen oppiminen ja toimintakyky eivät kehity iän mukaisesti, vaikka näönvarainen päättely onkin normaalia."@fi,
        "Fördröjd eller avvikande utveckling i ett barns tal och språk, samt svårigheter i muntlig framställning och/eller hörförståelse. Störningen innebär att ett barns språkliga inlärning och handlingsförmåga inte utvecklas i enlighet med åldern, även om slutledning baserad på visuell gestaltning är normal."@sv ;
    skos:prefLabel "specific language impairment"@en,
        "kielellinen erityisvaikeus"@fi,
        "specifik språkstörning"@sv .

