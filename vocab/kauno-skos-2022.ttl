yso:p17581 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2002-10-21"^^xsd:date ;
    skos:broader yso:p1882 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh87004063>,
        allars:Y42787,
        ysa:Y121297 ;
    skos:definition "Yhdysvalloissa 1950-luvulla syntynyt tyyli, jossa yhdistyivät rhythm and blues ja hillbilly. Vakioesityskokoonpanoon kuuluvat kitara, rummut ja kontrabasso. Tyylille on  tunnusomaista mm. kontrabasson slap-soittotekniikka. Tunnettuja esittäjiä ovat Elvis Presley (Sun-tuotanto), Carl Perkins, Gene Vincent ja Brian Setzer."@fi,
        "Musikstil som uppkom i USA på 1950-talet och som kombinerade rhythm and blues och hillbilly. Till standardbesättningen hör gitarr, trummor och kontrabas. Karakteristiskt för stilen är bl.a. slap-speltekniken på kontrabas. Kända företrädare är Elvis Presley (Sun-produktionen), Carl Perkins, Gene Vincent och Brian Setzer."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "rockabilly music"@en,
        "rockabilly"@fi,
        "rockabilly"@sv ;
    skos:related yso:p30084 .

