yso:p10240 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p1515 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85113601>,
        allars:Y24901,
        ysa:Y104138 ;
    skos:definition "Sävellystyyppi, joka yleistyi eurooppalaisessa taidemusiikissa 1700-luvulla. Rapsodia voi olla soitin- tai vokaalisävellys ja se perustuu usein kansanmusiikin tai populaarimusiikin melodioihin."@fi,
        "Kompositionstyp som blev allmän inom europeisk konstmusik på 1700-talet. En rapsodi kan vara en instrumental eller vokal komposition och den grundar sig ofta på melodier ur folk- eller populärmusik."@sv ;
    skos:hiddenLabel "rhapsody"@en,
        "rapsodia"@fi,
        "rapsodi"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "rhapsodies"@en,
        "rapsodiat"@fi,
        "rapsodier"@sv ;
    skos:related yso:p30090,
        yso:p38461,
        yso:p9876 ;
    yso-meta:singularPrefLabel "rhapsody"@en,
        "rapsodia"@fi,
        "rapsodi"@sv .

yso:p10245 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p1515 ;
    skos:closeMatch allars:Y17579,
        ysa:Y101334 ;
    skos:definition "Soittotekninen harjoituskappale (étude, study). Etydejä on sävelletty myös itsenäisiksi konserttikappaleiksi (mm. pianolle Chopin ja Debussy tai kitaralle Villa-Lobos)."@fi,
        "Instrumentalt övningsstycke (étude, study). Etyder har också komponerats som självständiga konsertstycken (bl.a. för piano av Chopin och Debussy eller för gitarr av Villa-Lobos)."@sv ;
    skos:hiddenLabel "étude"@en,
        "etydi"@fi,
        "etyd"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p29991 ;
    skos:prefLabel "études"@en,
        "etydit"@fi,
        "etyder"@sv ;
    skos:related yso:p1514,
        yso:p29883 ;
    yso-meta:singularPrefLabel "étude"@en,
        "etydi"@fi,
        "etyd"@sv .

yso:p10247 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:altLabel "koraalisinfoniat"@fi,
        "kuorosinfoniat"@fi,
