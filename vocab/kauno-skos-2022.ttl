ysometa:deprecatedHasPart a owl:ObjectProperty ;
    rdfs:domain ysometa:DeprecatedConcept .

ysometa:deprecatedPartOf a owl:ObjectProperty ;
    rdfs:domain ysometa:DeprecatedConcept .

ysometa:developmentComment a owl:DatatypeProperty ;
    rdfs:comment "vain kehitykseen käytettävä kommentti"@fi ;
    rdfs:domain ysometa:Class ;
    rdfs:subPropertyOf rdfs:comment ;
    skos:note "vain kehitykseen käytettävä kommentti"@fi ;
    skos:prefLabel "developmentComment" .

