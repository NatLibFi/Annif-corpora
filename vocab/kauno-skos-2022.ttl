yso:p21446 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Eurooppa-valmistelukunta-verkkosivusto"@fi,
        "Tietoa parlamentista. Lainsäädäntävalta [https://www.europarl.europa.eu/about-parliament/fi/powers-and-procedures/legislative-powers]"@fi ;
    dct:created "2008-10-13"^^xsd:date ;
    skos:altLabel "kuuleminen (Euroopan unionin kuulemismenettely)"@fi,
        "kuulemismenettely (Euroopan unionin kuulemismenettely)"@fi,
        "samrådsförfarande"@sv ;
    skos:broader yso:p7594 ;
    skos:closeMatch allars:Y36789,
        ysa:Y161724 ;
    skos:definition "Consultation procedure is a special legislative procedure, whereby European Parliament is asked for its opinion on proposed legislation before the Council adopts it. -- EuroVoc"@en,
        "Kuulemismenettelyssä Euroopan parlamentin neuvoston on kuultava Euroopan parlamenttia ja pyrittävä ottamaan sen näkemykset huomioon. Parlamentin kanta ei kuitenkaan sido neuvostoa."@fi,
        "Vid samrådsförfarande måste Europeiska unionens råd höra Europaparlamentet och beakta dess åsikter. Parlamentets ståndpunkt är dock inte bindande för rådet."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "consultation procedure (EU)"@en,
        "Euroopan unionin kuulemismenettely"@fi,
        "samrådsförfarande (EU)"@sv ;
    skos:related yso:p24409 .

