yso:p30137 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-07"^^xsd:date ;
    skos:altLabel "Franco-Flemish Schools"@en,
        "alankomaalaiset koulukunnat"@fi,
        "flaamilaiset koulukunnat"@fi,
        "ranskalais-flaamilaiset koulukunnat"@fi,
        "flamländska skolorna"@sv ;
    skos:broader yso:p8954 ;
    skos:closeMatch allars:Y51796,
        ysa:Y214384 ;
    skos:definition "1400–1500-luvuilla kukoistanut vokaalipolyfoninen sävellystyyli, jonka tunnetuimmat edustajat olivat Guillaume Du Fay, Henricus Isaac, Josquin des Prez ja Jean de Ockeghem."@fi,
        "Kompositionsstil som blomstrade på 1400-1500-talen och som karaktäriserades av polyfoni. De mest kända företrädarna för stilen var Guillaume Du Fay, Henricus Isaac, Josquin des Prez och Jean de Ockeghem."@sv ;
    skos:hiddenLabel "Franco-Flemish School"@en,
        "Netherlandish School"@en,
        "alankomaalainen koulukunta"@fi,
        "alankomainen koulukunta"@fi,
        "flaamilainen koulukunta"@fi,
        "ranskalais-flaamilainen koulukunta"@fi ;
    skos:inScheme kauno: ;
    skos:prefLabel "Netherlandish Schools"@en,
        "alankomaiset koulukunnat"@fi,
        "nederländska skolorna"@sv ;
    yso-meta:singularAltLabel "Franco-Flemish School"@en,
        "alankomaalainen koulukunta"@fi,
        "flaamilainen koulukunta"@fi,
        "ranskalais-flaamilainen koulukunta"@fi ;
    yso-meta:singularPrefLabel "Netherlandish School"@en,
        "alankomainen koulukunta"@fi .

