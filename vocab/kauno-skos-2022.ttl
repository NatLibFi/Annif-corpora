    skos:hiddenLabel "controlled corporation"@en,
        "offshore company"@en,
        "offshore-yhtiö"@fi,
        "väliyhteisö"@fi,
        "väliyhtiö"@fi ;
    skos:inScheme kauno: ;
    skos:note "Verovelvolliset yrittävät joissakin tapauksissa välttää verotusta siirtämällä tuloja matalan verotuksen maissa sijaitseviin yhteisöihin (väliyhteisöihin). Matalan verotuksen valtiossa olevat yhteisöt ovat usein kansainvälisten yritysten verosuunnittelun apuväline, mutta tällaisten yhteisöjen avulla voidaan pyrkiä välttämään myös luonnollisten henkilöiden pääomatulojen ja ansiotulojen verotusta."@fi,
        "Bolag med säte i ett land med lägre beskattning, ofta använt som ett medel för skatteplanering."@sv ;
    skos:prefLabel "controlled companies"@en,
        "väliyhteisöt"@fi,
        "bassamfund"@sv ;
    skos:related yso:p10499,
