yso:p21685 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2007-10-25"^^xsd:date ;
    skos:altLabel "musicology (research activity)"@en,
        "musiikin tutkimus"@fi,
        "musiikkitiede"@fi,
        "musikologia"@fi,
        "musikologi"@sv,
        "musikvetenskap"@sv ;
    skos:broader yso:p183 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85089048>,
        allars:Y35516,
        ysa:Y155072 ;
    skos:definition "Musiikin ja musiikin harjoittamisen systemaattinen tutkiminen niiden kaikissa ilmenemismuodoissa."@fi,
        "Systematisk forskning om musik och musikutövning i alla dess former."@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p12989,
        yso:p13805,
        yso:p16868,
        yso:p35531,
        yso:p38289,
        yso:p38778,
        yso:p8727 ;
    skos:note "Käsitettä käytetään, kun kyse ei ole jostain täsmällisemmästä tutkimussuuntauksesta kuten etnomusikologia tai kognitiivinen musiikkitiede tai kun tällaista erottelua ei kyetä tekemään."@fi,
        "Begreppet används då det inte är frågan om någon mer precis forskningsriktning såsom etnomusikologi eller kognitiv musikvetenskap, eller då en sådan avskiljning inte kan göras."@sv ;
    skos:prefLabel "music research"@en,
        "musiikintutkimus"@fi,
        "musikforskning"@sv ;
    skos:related yso:p10669,
        yso:p19358,
        yso:p3747 .

