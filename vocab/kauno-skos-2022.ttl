    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85081076>,
        allars:Y51834,
        ysa:Y214554 ;
    skos:definition "Meksikossa yleisen, mestitsikulttuuriin kuuluvan, kokoonpanon populaarimusiikkia. Viulun ja kitaroiden lisäksi mariachi-yhtyeeseen kuuluu trumpetti ja lyömäsoittimia. Sävellyksissä esiintyy sekä perinne- että populaarimusiikkityylejä."@fi,
        "Mexikansk populärmusik med viss uppsättning, förutom violin och gitarrer hör även trumpet och slaginstrument till ett mariachiband. I kompositionerna förekommer både traditionella och populärmusikaliska stilar."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "mariachi"@en,
        "mariachimusiikki"@fi,
        "mariachimusik"@sv ;
    skos:related yso:p29865 .

