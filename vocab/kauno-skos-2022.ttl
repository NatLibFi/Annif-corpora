        kaunometa:Concept ;
    dc:source "Wikipedia / YSA"@fi,
        "Översatt från den finska definitionen"@sv ;
    rdfs:comment "Pelejä, joissa kaksi tai useampi osapuoli yrittää saavuttaa pelin voittoon johtavan tavoitteensa tekemällä suunnitelmia ja toteuttamalla ne vastustajan tai vastustajien päihittämiseksi. Klassisia strategiapelejä ovat esimerkiksi shakki ja tammi"@fi,
        "Spel där två eller flera deltagare försöker vinna genom att göra upp planer och förverkliga dem för att överlista sina motståndare. Klassiska strategispel är t.ex. schack och damspel"@sv ;
    skos:broader yso:p6062 ;
    skos:exactMatch yso:p25403 ;
    skos:inScheme kauno: ;
    skos:prefLabel "strategiapelit"@fi,
        "strategispel"@sv ;
