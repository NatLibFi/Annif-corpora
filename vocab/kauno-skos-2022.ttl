yso:p18397 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1999-11-17"^^xsd:date ;
    skos:broader yso:p6580 ;
    skos:closeMatch allars:Y23567,
        ysa:Y110608 ;
    skos:hiddenLabel "novel food"@en,
        "uuselintarvike"@fi,
        "nytt livsmedel"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p18396 ;
    skos:note "Uuselintarvikkeet jaetaan kahteen ryhmään. 1) Uuselintarvikkeet ovat elintarvikkeita, joiden valmistuksessa on käytetty geenitekniikkaa. 2) Uuselintarvikkeet ovat elintarvikkeita, joilla on uusi tai tarkoituksellisesti muunnettu kemiallinen rakenne tai joita ei ennen ole käytetty elintarvikkeina tai jotka on valmistettu uudella tavalla"@fi,
        "Avser antingen livsmedel som tillverkats med genteknik, livsmedel med en ny eller avsiktligt förändrad kemisk struktur, livsmedel som inte tidigare använts som livsmedel, eller som tillverkats på ett nytt sätt."@sv ;
    skos:prefLabel "novel foods"@en,
        "uuselintarvikkeet"@fi,
        "nya livsmedel"@sv ;
    yso-meta:singularPrefLabel "novel food"@en,
        "uuselintarvike"@fi,
        "nytt livsmedel"@sv .

