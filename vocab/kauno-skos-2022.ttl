yso:p9199 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1986-06-01"^^xsd:date ;
    rdau:P60686 yso:p9200 ;
    skos:broader yso:p1307 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85075720>,
        allars:Y15068,
        ysa:Y100422 ;
    skos:inScheme kauno: ;
    skos:note "Legal assistance paid for in full or in part from State funds, available to persons of limited means. The term was in use until 2002. For later use, see [http://www.yso.fi/onto/yso/p9200]."@en,
        "Kansalaisille oikeusasioiden hoidossa järjestetystä avusta käytettiin vuoteen 2002 asti käsitettä yleinen oikeusapu. Tästä eteenpäin siitä on käytetty käsitettä [http://www.yso.fi/onto/yso/p9200]."@fi,
        "Termen användes t.o.m. 2002 för den juridiska hjälp en enskild person kan få. Därefter används begreppet [http://www.yso.fi/onto/yso/p9200]."@sv ;
    skos:prefLabel "public legal aid"@en,
        "yleinen oikeusapu"@fi,
        "allmän rättshjälp"@sv ;
    skos:related yso:p13146,
        yso:p9198,
        yso:p9201 .

yso:p9200 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1992-06-05"^^xsd:date ;
    rdau:P60683 yso:p9199 ;
    skos:altLabel "julkinen oikeusapu"@fi ;
    skos:broader yso:p1307 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85075720>,
        allars:Y30769,
        ysa:Y106174 ;
    skos:inScheme kauno: ;
    skos:note "Previously \"legal aid\" referred to judicial assistance given by one authority to another. From 2002 onwards, \"executive assistance\" refers to judicial assistance and \"public legal aid\" to legal assistance paid for in full or in part from State funds, available to persons of limited means."@en,
        "Kansalaisille oikeusasioiden hoidossa järjestetystä avusta käytettiin vuoteen 2002 asti termiä yleinen oikeusapu."@fi,
        "Termen avsåg tidigare hjälp som en domstol ger en annan domstol. Fr.o.m. 2002 avser begreppet den rättshjälp som en enskild medborgare kan få vid skötseln av juridiska frågor. För detta användes tidigare begreppet [http://www.yso.fi/onto/yso/p9199]. För den hjälp en domstol kan ge en annan används begreppet [http://www.yso.fi/onto/yso/p12955]."@sv ;
    skos:prefLabel "legal aid"@en,
        "oikeusapu"@fi,
        "rättshjälp"@sv ;
    skos:related yso:p13146,
        yso:p9198,
        yso:p9201 .

