        yso:p4515,
        yso:p6944,
        yso:p7319,
        yso:p8205 ;
    skos:note "Physical objects as a whole when they are not primarily functional entities i.e. systems."@en,
        "This is a hierarchical concept not to be used in subject cataloging."@en,
        "Käsite on tyypiltään hierarkisoiva. Käsitettä ei ole tarkoitettu käytettäväksi kuvailussa."@fi,
        "Vain sellaiset fyysisten objektien muodostamat kokonaisuudet, jotka ovat ensisijaisesti kokonaisuuksia, mutta eivät kuitenkaan toiminnallisia kokonaisuuksia eli järjestelmiä."@fi,
        "Begreppstypen är hierarkiserande. Begreppet är inte avsett för användning vid innehållsbeskrivning."@sv,
        "Endast sådana helheter utgjorda av fysiska objekt, som i första hand är helheter, men ändå inte funktionella helheter, alltså system."@sv ;
    skos:prefLabel "physical whole"@en,
        "fyysiset kokonaisuudet"@fi,
        "fysiska helheter"@sv ;
    yso-meta:singularPrefLabel "fyysinen kokonaisuus"@fi,
        "fysisk helhet"@sv .

