yso:p29762 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2017-06-02"^^xsd:date ;
    skos:altLabel "punk rock music"@en,
        "punkrock"@fi,
        "punk rock"@sv ;
    skos:broader yso:p1882 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85109128>,
        allars:Y51524,
        ysa:Y505068 ;
    skos:definition "1970-luvun puolivälissä Iso-Britanniassa kehittynyt nuorison alakulttuurin suosima musiikkityyli. Punk rock oli rockin kaupallisuutta ja raskasta sovittamista vastaan noussut kapinaliike, joka ilmeni musiikissa sanoitusten suoraviivaisuutena ja kantaaottavuutena. Sävellykset ovat yleensä lyhyitä, nopeatempoisia, dynaamisesti tasaisia, 1-3 soinnulla soitettavia pienten yhtyeiden musiikkia."@fi,
        "Musikstil populär bland ungdomar tillhörande subkultur, som utvecklades i mitten av 1970-talet i Storbritannien. Punkrock var en upprorsrörelse som reagerade mot bl.a. rockens kommersialism och det framkom i texternas rättframhet och ställningstagande. Kompositionerna är vanligen korta, dynamiskt jämna, har snabbt tempo och spelas med 1-3 ackord, samt framförs av små band."@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p29637,
        yso:p38076 ;
    skos:prefLabel "punk rock"@en,
        "punk rock"@fi,
        "punkrock"@sv ;
    skos:related yso:p30039,
        yso:p38041,
        yso:p5229 .

