        "hausa"@sv ;
    skos:broader yso:p24749 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85059313>,
        allars:Y45082,
        ysa:Y185977 ;
    skos:inScheme kauno: ;
    skos:note "Afrikan toiseksi puhutuin kieli. Suurin osa äidinkielisistä puhujista asuu Nigeriassa sekä Nigerissä. Lisäksi hausaa käytetään lingua francana useissa Länsi-Afrikan maissa erityisesti muslimien keskuudessa."@fi,
        "Afrikanskt språk som talas i främst Nigeria och Niger, samt därtill används som lingua franca i flera västafrikanska länder, särskilt bland muslimer."@sv ;
    skos:prefLabel "Hausa language"@en,
        "hausan kieli"@fi,
        "hausa (språk)"@sv .

