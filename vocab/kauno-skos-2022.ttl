yso:p14413 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:altLabel "12-säveljärjestelmä"@fi,
        "12-säveltekniikka"@fi,
        "dodekafonia"@fi,
        "kaksitoistasäveltekniikka"@fi,
        "12-tonssystem"@sv,
        "12-tonsteknik"@sv,
        "dodekafoni"@sv,
        "tolvtonsteknik"@sv ;
    skos:broader yso:p12382 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85139017>,
        allars:Y27800,
        ysa:Y95760 ;
    skos:definition "Sävellystekniikka, jossa sävelasteikon 12 säveltä on määritelty tasa-arvoisiksi ja luovuttu tonaalisuuteen kuuluvista sävelten välisistä hierarkkisista suhteista. Järjestelmälle on tunnusomaista ns. sävelrivin käyttö, joka sitoo melodianmuodostuksen ennalta laadittuun sääntöön."@fi,
        "Kompostionsteknik i vilken tonskalans tolv toner bestäms som jämlika och man avstår från hierarkiska förhållanden mellan tonerna. Användning av s.k. tonrad, vilken binder melodibildningen till en på förhand skapad regel är karakteristiskt för systemet."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "twelve-tone system"@en,
        "kaksitoistasäveljärjestelmä"@fi,
        "tolvtonssystem"@sv ;
    skos:related yso:p12383,
        yso:p14414 .

