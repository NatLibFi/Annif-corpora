yso:p16159 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2003-06-16"^^xsd:date ;
    skos:broader yso:p3673 ;
    skos:closeMatch allars:Y29764,
        ysa:Y125737 ;
    skos:inScheme kauno: ;
    skos:note "Ympäristörakentamista ovat ihmisen toiminnallaan aiheuttamien maisemavaurioiden korjaaminen tai ympäristön terveyshaittojen vähentämiseen pyrkivät rakennustoimenpiteet. Ympäristörakentamiseen kuuluvat myös ympäristöarvot säilyttävä viherrakentaminen ja maisemointi sekä rakentamiskohteista mm. kadut, sillat, aukiot, vesiväylät, puistot ja muut viher- ja virkistysalueet, pihat ja puutarhat."@fi,
        "Miljöbyggande avser reparation av skador som människors verksamhet förorsakat miljön eller byggåtgärder som strävar att minska miljöns skadliga hälsoeffekter. Miljöbyggande omfattar också grönområdesplanering för att bevara miljövärden och byggen som gator, broar, öppna platser, vattenleder, parker och övriga grön- och rekreationsområden, gårdar och trädgårdar."@sv ;
    skos:prefLabel "environmental construction"@en,
        "ympäristörakentaminen"@fi,
        "miljöbyggande"@sv .

