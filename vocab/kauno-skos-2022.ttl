yso:p11034 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Rakennusperintöstrategia : valtioneuvoston päätös 13.6.2001"@fi ;
    dct:created "2002-02-20"^^xsd:date ;
    skos:broader yso:p8475 ;
    skos:closeMatch allars:Y16498,
        ysa:Y117635 ;
    skos:inScheme kauno: ;
    skos:note "Rakennusperintö muodostuu yhdyskuntarakenteesta, rakennuksista sisä- ja ulkotiloineen, pihoista ja puistoista, teknisistä rakenteista kuten kadut, tiet, sillat, kanavat sekä muista ihmisten rakentamista kohteista ympäristössä."@fi,
        "Byggnadsarv utgörs av bebyggelsestruktur, byggnader med inomhus- och utomhusutrymmen, gårdar och parker, tekniska strukturer såsom gator, vägar, broar, kanaler samt andra objekt byggda av människor i omgivningen."@sv ;
    skos:prefLabel "building heritage"@en,
        "rakennusperintö"@fi,
        "byggnadsarv"@sv ;
    skos:related yso:p11295,
        yso:p12756,
        yso:p13609,
        yso:p17422,
        yso:p2327,
        yso:p2688 .

