        ysa:Y169390 ;
    skos:hiddenLabel "vieraslaji"@fi,
        "vierasperäinen laji"@fi,
        "främmande art"@sv,
        "introducerad art"@sv,
        "invasiv art"@sv,
        "skadlig främmande art"@sv ;
    skos:inScheme kauno: ;
    skos:note "Vieraslajiksi kutsutaan sellaista luontoon levinnyttä tulokaslajia, joka ei alun perin ole kuulunut ekosysteemiin eikä olisi pystynyt sinne omin neuvoin leviämään. Vieraslaji on ylittänyt luontaiset leviämisesteet, kuten mantereen, meren tai vuoriston, ihmisen tietoisella tai tahattomalla myötävaikutuksella."@fi,
        "Art som spridit sig i naturen och ett ekosystem som det från början inte hör hemma i och till vilket den inte hade kunnat sprida sig på egen hand, som en följd av människans medvetna eller oavsiktliga verksamhet."@sv ;
    skos:prefLabel "introduced species"@en,
        "vieraslajit"@fi,
        "främmande arter"@sv ;
    skos:related yso:p29331,
        yso:p2994 ;
    yso-meta:singularAltLabel "vierasperäinen laji"@fi,
        "introducerad art"@sv,
        "invasiv art"@sv,
        "skadlig främmande art"@sv ;
    yso-meta:singularPrefLabel "vieraslaji"@fi,
        "främmande art"@sv .

