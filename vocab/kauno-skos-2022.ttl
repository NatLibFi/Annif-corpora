yso:p11637 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2002-02-18"^^xsd:date ;
    skos:altLabel "unemployment traps"@en,
        "tuloloukut"@fi,
        "työttömyysloukut"@fi,
        "arbetslöshetsfällor"@sv,
        "incitamentsfällor"@sv,
        "inkomstfällor"@sv ;
    skos:broader yso:p605 ;
    skos:closeMatch allars:Y34463,
        ysa:Y117544 ;
    skos:hiddenLabel "incentive trap"@en,
        "unemployment trap"@en,
        "kannustinloukku"@fi,
        "tuloloukku"@fi,
        "työttömyysloukku"@fi,
        "arbetslöshetsfälla"@sv,
        "flitfälla"@sv,
        "incitamentsfälla"@sv,
        "inkomstfälla"@sv ;
    skos:inScheme kauno: ;
    skos:note "Kannustinloukkuja on kahdenlaisia. Tuloloukku tarkoittaa, että bruttotulojen kasvua ei seuraakaan käytettävissä olevien tulojen kasvu. Työttömyysloukku tarkoittaa, että henkilön ei kannata vastaanottaa työtä, koska sosiaaliturva tarjoaa hyvän toimeentulon."@fi,
        "Finlandssvensk term. Det finns två typer av flitfällor. En inkomstfälla innebär att bruttoinkomsternas tillväxt inte följer de disponibla inkomsternas tillväxt. En arbetslöshetsfälla innebär att det inte lönar sig för en person att ta emot arbete, eftersom socialskyddet ger god utkomst."@sv ;
    skos:prefLabel "incentive traps"@en,
        "kannustinloukut"@fi,
        "flitfällor"@sv ;
    skos:related yso:p12764,
        yso:p941 ;
    yso-meta:singularAltLabel "unemployment trap"@en,
        "tuloloukku"@fi,
        "työttömyysloukku"@fi,
        "arbetslöshetsfälla"@sv,
        "incitamentsfälla"@sv,
        "inkomstfälla"@sv ;
    yso-meta:singularPrefLabel "incentive trap"@en,
        "kannustinloukku"@fi,
        "flitfälla"@sv .

