yso:p10544 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p5070 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85022426>,
        allars:Y20536,
        ysa:Y102142 ;
    skos:definition "Kamariorkesterina pidetään esityskokoonpanoa, jossa on edustajia vähintään kahdesta soitinperheestä ja jossa on korkeintaan noin 25 soittajaa. Tätä suuremmista kokoonpanoista käytetään käsitteitä orkesterit, sinfoniaorkesterit ja puhallinorkesterit. Jos kokoonpanossa on vain jousisoittimia (lisäksi voi olla joitakin lyömäsoittimia), käytetään käsitettä [http://www.yso.fi/onto/yso/p15915]."@fi,
        "Besättning i vilken ingår representanter från minst två instrumentfamiljer och med högst ca 25 instrumentalister. Om besättningar som är större än så används begreppen orkestrar, sinfoniorkestrar och blåsorkestrar. Om ensembler med bara stråkinstrument (därtill kan det finnas några slaginstrument) används begreppet [http://www.yso.fi/onto/yso/p15915]."@sv ;
    skos:hiddenLabel "chamber orchestra"@en,
        "kamariorkesteri"@fi,
        "kammarorkester"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p15915 ;
    skos:prefLabel "chamber orchestras"@en,
        "kamariorkesterit"@fi,
        "kammarorkestrar"@sv ;
    yso-meta:singularPrefLabel "chamber orchestra"@en,
        "kamariorkesteri"@fi,
        "kammarorkester"@sv .

