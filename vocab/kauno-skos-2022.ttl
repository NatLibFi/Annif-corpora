        yso-meta:Concept ;
    dct:created "2012-06-07"^^xsd:date ;
    skos:broader yso:p6848 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh86000737>,
        allars:Y44670,
        ysa:Y186430 ;
    skos:definition "Tuote, johon on luvattomasti liitetty toiselle kuuluva tavaramerkki tai sen jäljitelmä, tai tuote, joka luvattomasti imitoi toisen tuotteen mallioikeudella suojattua ulkomuotoa."@fi,
        "Produkt i vilken ett varumärke eller en imitation av det som tillhör en annan olovligen har infogats, eller en produkt som olovligen imiterar en annan produkts yttre form, som är skyddad av mönsterrätt."@sv ;
    skos:hiddenLabel "tuoteväärennös"@fi,
        "produktförfalskning"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "counterfeit goods"@en,
        "tuoteväärennökset"@fi,
        "produktförfalskningar"@sv ;
    skos:related yso:p34410 ;
    yso-meta:singularPrefLabel "tuoteväärennös"@fi,
        "produktförfalskning"@sv .

