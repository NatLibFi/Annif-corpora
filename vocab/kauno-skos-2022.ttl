yso:p27183 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2013-03-21"^^xsd:date ;
    skos:altLabel "biological assays"@en,
        "bioassay"@sv ;
    skos:broader yso:p3971 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85014169>,
        allars:Y45572,
        ysa:Y191755 ;
    skos:hiddenLabel "bioassay"@en,
        "biological assay"@en,
        "biotesti"@fi ;
    skos:inScheme kauno: ;
    skos:note "A method of determining the biological activity or potency of a substance, as a vitamin or hormone, by testing its effect on the growth of an organism."@en,
        "Testi, jossa yhdiste määritetään biologisen koemateriaalin avulla. Koemateriaalina voi olla jokin organismi, elin tai kudosta. Käytetään aineiden pitoisuuksien ja vaikutusten selvittämiseen etenkin biotieteissä."@fi,
        "Test i vilket en substans bestäms med hjälp av biologiskt provmaterial. Som provmaterial kan en organism, ett organ eller en vävnad fungera. Används för att utreda ämnens halter och effekter särskilt inom biovetenskaperna."@sv ;
    skos:prefLabel "bioassays"@en,
        "biotestit"@fi,
        "biotest"@sv ;
    yso-meta:singularAltLabel "biological assay"@en ;
    yso-meta:singularPrefLabel "bioassay"@en,
        "biotesti"@fi .

