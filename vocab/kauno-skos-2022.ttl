yso:p6293 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1998-09-16"^^xsd:date ;
    skos:altLabel "skinit"@fi,
        "skinheads"@sv,
        "skinnhuvuden"@sv ;
    skos:broader yso:p1127 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh96000234>,
        allars:Y29615,
        ysa:Y111423 ;
    skos:hiddenLabel "skinhead"@en,
        "skinhead"@fi,
        "skini"@fi,
        "skinhead"@sv,
        "skinnhuvud"@sv,
        "skinnskalle"@sv ;
    skos:inScheme kauno: ;
    skos:note "Skinhead-kulttuuri syntyi  1960-luvun puolivälissä Isossa-Britanniassa. Skinheadit omaksuivat joitakin  ns. kovan mod-kulttuurin piirteitä, mutta liittivät niihin vahvasti proletaarisia symboleja. Alkuperäiseen skinhead-kulttuuriin ei välttämättä liittynyt rasismia. Myöhemmin siihen on liittynyt rasististisia, väkivaltaisia ja äärioikeistolaisia piirteitä"@fi,
        "Subkultur som uppkom i mitten av 1960-talet i Storbritannien och som hade några drag av mods-kulturen, men också förenade starkt proletariska symboler med den. Rasism hörde inte nödvändigtvis till den ursprungliga skinheadsrörelsen, men senare har den inkluderat rasistiska, våldsamma och högerextrema drag."@sv ;
    skos:prefLabel "skinheads"@en,
        "skinheadit"@fi,
        "skinnskallar"@sv ;
    skos:related yso:p6291,
        yso:p6294,
        yso:p8552 ;
    yso-meta:singularAltLabel "skini"@fi,
        "skinhead"@sv,
        "skinnhuvud"@sv ;
    yso-meta:singularPrefLabel "skinhead"@en,
        "skinhead"@fi,
        "skinnskalle"@sv .

