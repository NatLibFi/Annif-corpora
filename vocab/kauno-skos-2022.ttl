yso:p26071 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-03-14"^^xsd:date ;
    skos:altLabel "kaukosiirtäminen"@fi ;
    skos:broader yso:p5700 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh95010569>,
        allars:Y43560,
        ysa:Y184937 ;
    skos:inScheme kauno: ;
    skos:note "Tarkoittaa siirtämistä teleportin eli kaukosiirtimen avulla materiaa paikasta toiseen pitkiäkin matkoja, hajottamalla aine lähtöpaikassa osiinsa ja kokoamalla se päätepisteessä takaisin entiseen muotoonsa. Teleportti esiintyy fiktiivisenä etenkin tieteiskirjallisuudessa, mutta sitä kehitetään myös todellisuudessa."@fi,
        "Avser förflyttning av materia från en plats till en annan, med hjälp av en teleport, genom att på utgångsplatsen sönderdela materia i sina delar och samla ihop den till sin tidigare form vid ändpunkten. Förekommer som fiktiv i science fiction, men är också föremål för forskning i verkligheten."@sv ;
    skos:prefLabel "teleportation"@en,
        "teleportaatio"@fi,
        "teleportering"@sv .

