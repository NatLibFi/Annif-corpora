yso:p26928 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2013-03-26"^^xsd:date ;
    skos:altLabel "sijaintiin perustuvat pelit"@fi,
        "pervasiva spel"@sv ;
    skos:broader yso:p6062 ;
    skos:closeMatch allars:Y45606,
        ysa:Y191912 ;
    skos:hiddenLabel "pervasive game"@en,
        "pervasiivinen peli"@fi,
        "sijaintiin perustuva peli"@fi,
        "pervasivt spel"@sv ;
    skos:inScheme kauno: ;
    skos:narrower kauno:p6459,
        yso:p29442 ;
    skos:note "Todellisuutta ja virtuaalimaailmaa yhdistävä, mobiililaitteilla pelattava pelimuoto, joka yhdistää fyysisen ja virtuaalisen tilan, kiinnittyy arkielämään ja voi hämärtää pelaajan ja ei-pelaajan rooleja."@fi,
        "Spelform som spelas på mobila apparater och som kombinerar verkligheten med den virtuella världen och det fysiska utrymmet med det virtuella, samt som också kan fördunkla spelares och icke-spelares roller."@sv ;
    skos:prefLabel "pervasive games"@en,
        "pervasiiviset pelit"@fi,
        "verklighetsspel"@sv ;
    yso-meta:singularAltLabel "sijaintiin perustuva peli"@fi,
        "pervasivt spel"@sv ;
    yso-meta:singularPrefLabel "pervasive game"@en,
        "pervasiivinen peli"@fi .

