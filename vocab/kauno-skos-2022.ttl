    skos:closeMatch allars:Y41816,
        ysa:Y118949 ;
    skos:inScheme kauno: ;
    skos:note "eContent on Euroopan yhteisön monivuotinen ohjelma maailmanlaajuisten verkkojen eurooppalaisen digitaalisen sisällön kehittämiseksi ja käytön tukemiseksi sekä tietoyhteiskunnan kielellisen monimuotoisuuden edistämiseksi. eContent-ohjelma on osa eEurope-hanketta."@fi,
        "Europeiska gemenskapens fleråriga program för att utveckla det europeiska digitala innehållet i globala nätverk och stöda användningen av detta, samt främja den språkliga mångfalden i informationssamhället. eContent-programmet är en del av eEurope-projektet."@sv ;
    skos:prefLabel "eContent Programme"@en,
        "eContent-ohjelma"@fi,
        "eContent-programmet"@sv ;
    skos:related yso:p5406 .

