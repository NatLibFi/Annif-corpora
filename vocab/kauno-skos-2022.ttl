yso:p17833 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1993-05-05"^^xsd:date ;
    skos:broader yso:p220 ;
    skos:closeMatch allars:Y25630,
        ysa:Y107336 ;
    skos:inScheme kauno: ;
    skos:note "Elämänkäsitys, filosofia ja uskonto, joka painottaa ihmisen eläimellistä ja ruumiillista puolta. Satanismin mukaan vain itsenäiset, individualistiset ja egoistiset moraalikäsitykset ovat hyväksyttäviä. Personoidun pahuuden palvonnasta käytetään käsitettä [http://www.yso.fi/onto/yso/p9012]."@fi,
        "Avser livsuppfattning, filosofi och religion som betonar människans djuriska och kroppsliga sida. Enligt denna satanism är det bara självständiga, individualistiska och egoistiska moraluppfattningar som är godtagbara. Om dyrkan av Satan som personifierad ondska används begreppet [http://www.yso.fi/onto/yso/p9012]."@sv ;
    skos:prefLabel "satanism"@en,
        "satanismi"@fi,
        "satanism"@sv ;
    skos:related yso:p9012 .

