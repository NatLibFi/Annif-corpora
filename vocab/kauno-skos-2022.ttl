yso:p13132 a skos:Concept,
        yso-meta:Individual ;
    dc:source "Lähde: Mir iskusstva : taiteen maailma"@fi ;
    dct:created "2001-10-02"^^xsd:date ;
    skos:broader yso:p2393 ;
    skos:closeMatch allars:Y44269,
        ysa:Y115605 ;
    skos:inScheme kauno: ;
    skos:note "Mir iskusstvan käsite kattaa lukuisia venäläisen kulttuurin ilmiöitä. Se tarkoittaa taiteilijaryhmää, kahta taideyhdistystä ja niiden taidenäyttelyitä, taidelehteä, graafisen suunnittelun suuntausta, venäläisen teatterin voittokulkua Euroopassa ja omaperäistä taidefilosofiaa, joka oli sisäistänyt vuosisadan vaihteen kulttuurin uudet tuulet."@fi,
        "Konstnärlig rörelse inom rysk kultur, främst i början av 1900-talet."@sv ;
    skos:prefLabel "Mir iskusstva"@en,
        "Mir iskusstva"@fi,
        "Mir iskusstva"@sv ;
    skos:related yso:p6889 .

