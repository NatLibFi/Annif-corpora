allars:allars_juuri a rdfs:Resource .

kaunometa:facet a owl:ObjectProperty ;
    rdfs:domain kaunometa:Concept ;
    rdfs:range skos:Concept .

kaunometa:related a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "related" ;
    rdfs:domain kaunometa:Concept ;
    rdfs:range kaunometa:Concept .

