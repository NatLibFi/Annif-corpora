yso:p11577 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2004-10-12"^^xsd:date ;
    skos:broader yso:p1307 ;
    skos:closeMatch allars:Y30392,
        ysa:Y133691 ;
    skos:inScheme kauno: ;
    skos:note "Tarkoittaa vanhuksen, vammaisen tai sairaan henkilön kotona tapahtuvan hoidon tai muun huolenpidon turvaamiseksi annettavaa hoitopalkkiota ja palveluja. Tuki on sosiaalihuoltolain mukaista sosiaalipalvelua, jonka järjestämisvastuu on kunnalla"@fi,
        "Avser arvode eller tjänster som ges för att trygga vård eller annan omsorg om äldre, personer med funktionsnedsättning eller sjuka, som sker hemma. Stödet är en social service i enlighet med socialvårdslagen och kommunen är ansvarig för ordnandet."@sv ;
    skos:prefLabel "support for informal care"@en,
        "omaishoidon tuki"@fi,
        "stöd för anhörigvård"@sv .

