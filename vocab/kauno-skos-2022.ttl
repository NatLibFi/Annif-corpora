yso:p26302 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    skos:broader yso:p1271 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85109114>,
        allars:Y44454,
        ysa:Y185675 ;
    skos:hiddenLabel "Punic war"@en,
        "puunilaissota"@fi ;
    skos:inScheme kauno: ;
    skos:note "Tarkoittaa kolmea sotaa, jotka käytiin Rooman ja Karthagon välillä vuosina 264-146 eKr.  Sotien nimet tulevat siitä, että roomalaiset kutsuivat Karthagon asukkaita puunilaisiksi."@fi,
        "Avser tre krig som utkämpades mellan Rom och Karthago åren 264-146 f.Kr. Krigens namn kommer från att romarna kallade invånarna i Karthago för puner."@sv ;
    skos:prefLabel "Punic wars"@en,
        "puunilaissodat"@fi,
        "puniska krigen"@sv ;
    yso-meta:singularPrefLabel "Punic war"@en,
        "puunilaissota"@fi .

