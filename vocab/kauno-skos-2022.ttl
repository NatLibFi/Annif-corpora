yso:p10200 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p10199 ;
    skos:closeMatch allars:Y19569,
        ysa:Y101670 ;
    skos:definition "Sävellystapa, jossa on selkeästi erottuva melodia ja sitä säestävä soinnutus ja jossa kaikki äänet etenevät saman rytmisen kaavan mukaisesti. Homofonia on vastakohtana polyfoniselle tai kontrapunktiselle käsittelylle, jossa äänet etenevät itsenäisesti tai toisiaan imitoiden."@fi,
        "Kompositionssätt med en tydligt urskiljbar melodi med ackompanjerande harmonisering, och i vilket alla toner framskrider enligt samma rytmiska mönster."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "homophony"@en,
        "homofonia"@fi,
        "homofoni"@sv ;
    skos:related yso:p10198 .

