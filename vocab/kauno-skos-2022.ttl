yso:p3115 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-08-28"^^xsd:date ;
    skos:altLabel "tuhopoltto"@fi,
        "anlagd brand"@sv,
        "förstörelseverk"@sv,
        "sabotage"@sv,
        "sabotage (juridisk kategori)"@sv ;
    skos:broader yso:p125 ;
    skos:closeMatch allars:Y25505,
        ysa:Y109931 ;
    skos:definition "Tuhotyö on rikoslain mukaan yleisvaarallinen rikos, joka aiheuttaa yleistä hengen tai terveyden vaaraa, huomattavan taloudellisen vahingon vaaraa, tai vakavaa vaaraa energiahuollolle, yleiselle terveydenhuollolle, maanpuolustukselle, oikeudenhoidolle tai muulle näihin rinnastettavalle yhteiskunnan tärkeälle toiminnolle."@fi,
        "Avser allmänfarligt brott som orsakar allmän fara för liv eller hälsa, betydande ekonomisk skada, eller fara för energiförsörjningen, den allmänna hälsovården, försvaret, rättsvården eller någon med dessa jämförbar viktig samhällsfunktion."@sv ;
    skos:inScheme kauno: ;
    skos:note "Korvannut lakitekstissä 21.4.1995 mm. termin murhapoltto."@fi,
        "Ersatte i lagtext 21.4.1995 bl.a. termen mordbrand."@sv ;
    skos:prefLabel "criminal mischief"@en,
        "tuhotyö"@fi,
        "sabotage (brott)"@sv ;
    skos:related yso:p1662,
        yso:p3113 .

