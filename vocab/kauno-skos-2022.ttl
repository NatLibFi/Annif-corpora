yso:p2823 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: CD-Facta"@fi ;
    dct:created "1985-01-01"^^xsd:date ;
    skos:altLabel "gemensamma marknader"@sv ;
    skos:broader yso:p1865 ;
    skos:closeMatch allars:Y18904,
        ysa:Y104526 ;
    skos:definition "Taloudellisen yhteenliittymän muoto, jossa hyödykkeet ja tuotannontekijät voivat liikkua vapaasti maasta toiseen."@fi,
        "Form för ekonomisk sammanslutning, i vilken produkter och produktionsfaktorer kan röra sig fritt från land till land."@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p2824 ;
    skos:prefLabel "common market"@en,
        "yhteismarkkinat"@fi,
        "gemensam marknad"@sv ;
    skos:related yso:p1732,
        yso:p26734,
        yso:p2821,
        yso:p2822,
        yso:p2825 ;
    skos:scopeNote "Tarkoitettaessa Euroopan yhteisön sisäisiä yhteismarkkinoita käytä käsitettä [http://www.yso.fi/onto/yso/p2824]."@fi,
        "Om Europeiska gemenskapens inre gemensamma marknader används begreppet [http://www.yso.fi/onto/yso/p2824]."@sv .

yso:p2824 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: CD-Facta"@fi ;
    dct:created "2002-12-04"^^xsd:date ;
    skos:altLabel "sisäkauppa"@fi,
        "yhtenäismarkkinat"@fi,
        "internhandel"@sv ;
    skos:broader yso:p2823 ;
    skos:closeMatch allars:Y29609,
        ysa:Y122091 ;
    skos:inScheme kauno: ;
    skos:note "Markkina-alue, jossa henkilöiden, palveluiden, tavaroiden ja pääomien liikkuminen on vapaata ja jossa noudatetaan mm. yhtenäistä kilpailupolitiikkaa. Nimitystä on käytetty varsinaisesti Euroopan yhteisön jäsenmaiden välisestä kaupankäynnistä sen jälkeen kun  v. 1993-1994 poistettiin viimeisetkin tullimuodollisuudet jäsenmaiden välisestä kaupasta"@fi,
        "Marknadsområde, inom vilket råder fri rörelse för tjänster, varor och kapital och förs en gemensam konkurrenspolitik. Benämningen har använts särskilt om handeln mellan medlemsländer i den Europeiska gemenskapen, efter att de sista tullformaliteterna för handel mellan medlemsländerna avskaffades år 1993-1994."@sv ;
    skos:prefLabel "internal market"@en,
        "sisämarkkinat"@fi,
        "inre marknad"@sv ;
    skos:related yso:p16257,
        yso:p17236,
        yso:p1732,
        yso:p2821,
        yso:p2822,
        yso:p2825 .

