yso:p38069 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2018-07-03"^^xsd:date ;
    skos:broader yso:p261 ;
    skos:closeMatch allars:Y30805,
        ysa:Y219147 ;
    skos:definition "Kielen rakenteista muodostuva piirteiden yhdistelmä, jossa jokin seuraavista funktioista on dominoiva: kuvaileva (deskriptiivinen), kertova (narratiivinen), erittelevä (ekspositorinen), perusteleva (argumentoiva), ohjaileva (instruktiivinen). -- Tieteen termipankki"@fi,
        "Kombination av de drag som präglar språkets konstruktioner, i vilken någon av följande funktioner är dominerande: beskrivande (deskriptiv), berättande (narrativ), förklarande (expositorisk), argumenterande och instruerande (instruktiv)."@sv ;
    skos:hiddenLabel "text type"@en,
        "tekstityyppi"@fi,
        "texttyp"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "text types"@en,
        "tekstityypit"@fi,
        "texttyper"@sv ;
    skos:related yso:p16697,
        yso:p17134 ;
    yso-meta:singularPrefLabel "text type"@en,
        "tekstityyppi"@fi,
        "texttyp"@sv .

