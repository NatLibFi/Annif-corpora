        allars:Y20982,
        ysa:Y102659 ;
    skos:definition "Soitinmusiikkiteos, joka sisältää huomattavia solistisia osuuksia yhdelle tai useammalle soittimelle tai koko yhtyeelle tai orkesterille."@fi,
        "Instrumentalverk som innehåller betydande solistiska delar för ett eller flera instrument eller för ett helt band eller en orkester."@sv ;
    skos:hiddenLabel "concerto"@en,
        "concertino"@fi,
        "konsertiino"@fi,
        "konsertto"@fi,
        "soolokonsertto"@fi,
