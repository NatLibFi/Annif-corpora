yso:p20085 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Encyclopaedia iuridica Fennica"@fi ;
    dct:created "1986-06-01"^^xsd:date ;
    skos:altLabel "conciliation"@en,
        "mediation"@en ;
    skos:broader yso:p14 ;
    skos:closeMatch allars:Y18668,
        ysa:Y99018 ;
    skos:inScheme kauno: ;
    skos:note "Sovittelu rikosoikeudessa tarkoittaa sitä, että syyllinen sovittaa rikoksesta saamansa tuomion osapuolten sopimalla tavalla. Sovittelutoimintaa ei ole Suomessa järjestetty lainsäädännöllisin toimenpitein, vaan useimmiten se on organisoitu kuntien sosiaalitoimen yhteyteen."@fi,
        "Medling betyder inom straffrätt att den skyldiga sonar den dom denna fått för ett brott, på ett sätt som parterna överenskommit. Medlingsverksamhet är i Finland inte ordnad med legislativa åtgärder, utan organiseras oftast i anslutning till kommunernas socialförvaltning."@sv ;
    skos:prefLabel "arbitration"@en,
        "sovittelu"@fi,
        "medling"@sv ;
    skos:related yso:p20086,
        yso:p21262,
        yso:p22853 .

