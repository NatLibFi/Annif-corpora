        yso:p5264,
        yso:p570,
        yso:p6969,
        yso:p817,
        yso:p8232 ;
    skos:note "A temporal interval with qualities or characteristics through which it can be recognised and given at least an approximate time of beginning and end."@en,
        "This is a hierarchical concept not to be used in subject cataloging."@en,
        "Ajallinen kokonaisuus, jolla on tiettyjä tuntomerkkejä tai ominaisuuksia, joiden perusteella se voidaan tunnistaa, ja joiden perusteella sille voidaan määritellä vähintään summittainen alku- ja loppuaika."@fi,
        "Käsite on tyypiltään hierarkisoiva. Käsitettä ei ole tarkoitettu käytettäväksi kuvailussa."@fi,
        "Begreppstypen är hierarkiserande. Begreppet är inte avsett för användning vid innehållsbeskrivning."@sv,
        "Tidsmässig helhet som har vissa kännetecken eller egenskaper, på basis av vilka den kan igenkännas och på basis av vilka man kan bestämma dess ungefärliga start- och sluttid."@sv ;
    skos:prefLabel "periods of time"@en,
        "ajanjaksot"@fi,
        "tidsavsnitt"@sv ;
    yso-meta:singularPrefLabel "ajanjakso"@fi .

