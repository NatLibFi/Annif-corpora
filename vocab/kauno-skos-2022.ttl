yso:p24489 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2010-11-03"^^xsd:date ;
    skos:altLabel "intelligent agent software"@en,
        "intelligent software agents"@en,
        "älykkäät ohjelmistoagentit"@fi ;
    skos:broader yso:p26592 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh97000493>,
        allars:Y39775,
        ysa:Y175729 ;
    skos:hiddenLabel "intelligent agent"@en,
        "intelligent software agent"@en,
        "älykäs agentti"@fi,
        "älykäs ohjelmistoagentti"@fi,
        "intelligent agent"@sv ;
    skos:inScheme kauno: ;
    skos:note "Tarkoittaa tietokoneohjelmia, jotka yhdistävät sovelluksia ja tietokantaohjelmia virtuaalisessa ympäristössä. Älykkäissä agenteissa käytetään yleensä tekoälyä ja ne vaativat jonkin verran itsenäistä ongelmanratkaisua. Älykkäitä agentteja käytetään luomaan illuusio ihmismäisestä vuorovaikutuksesta."@fi,
        "Avser datorprogram som sammankopplar applikationer och databasprogram i en virtuell miljö. I dem används vanligen artificiell intelligens och krävs en del självständig problemlösning. Intelligenta agenter används för att skapa en illusion av människoliknande interaktion."@sv ;
    skos:prefLabel "intelligent agents"@en,
        "älykkäät agentit"@fi,
        "intelligenta agenter"@sv ;
    skos:related yso:p2616 ;
    yso-meta:singularAltLabel "älykäs ohjelmistoagentti"@fi ;
    yso-meta:singularPrefLabel "intelligent agent"@en,
        "intelligent software agent"@en,
        "älykäs agentti"@fi,
        "intelligent agent"@sv .

