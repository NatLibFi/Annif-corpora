        yso:p38217,
        yso:p38218 ;
    skos:note "Something which is either done or realised. As opposed to events, actions are not defined in terms of their duration."@en,
        "Jokin, joka tehdään tai toteutuu (toisin kuin tapahtuman määrittelyssä, kesto ei ole toiminnan osalta olennainen piirre)."@fi,
        "Något som görs eller förverkligas (till skillnad från händelsens definition är varaktigheten inte ett väsentligt drag i verksamheten/handlingen)."@sv ;
    skos:prefLabel "action"@en,
        "toiminta"@fi,
        "verksamhet"@sv ;
    skos:related yso:p21294,
        yso:p418 .

