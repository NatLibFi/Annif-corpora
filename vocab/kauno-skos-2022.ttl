yso:p21497 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Terminfo 4/2006, s. 21"@fi ;
    dct:created "2007-03-07"^^xsd:date ;
    skos:broader yso:p20648 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006008079>,
        allars:Y34610,
        ysa:Y151312 ;
    skos:hiddenLabel "dwarf planet"@en,
        "kääpiöplaneetta"@fi,
        "dvärgplanet"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p26701 ;
    skos:note "Aurinkoa kiertävä kappale, joka on riittävän suuri, että sen oma painovoima riittää muokkamaan kappaleen suunnilleen pallonmuotoiseksi. Kääpiöplaneetat eroavat planeetoista siten, että niiden kiertoratojen läheisyydessä voi liikkua muitakin merkittävän kokoisia kappaleita. Kääpiöplaneetta ei saa myöskään olla minkään planeetan kuu."@fi,
        "Himlakropp som kretsar kring solen och som är tillräckligt stor för att dess egen tyngdkraft skall räcka till för att forma kroppen till i det närmaste ett klot. Dvärgplaneter skiljer sig från planeter på så vis att även andra kroppar av betydlig storlek kan röra sig i närheten av deras omloppsbanor. En dvärplanet kan inte heller vara måne till någon planet."@sv ;
    skos:prefLabel "dwarf planets"@en,
        "kääpiöplaneetat"@fi,
        "dvärgplaneter"@sv ;
    skos:related yso:p10343,
        yso:p6224 ;
    yso-meta:singularPrefLabel "dwarf planet"@en,
        "kääpiöplaneetta"@fi,
        "dvärgplanet"@sv .

