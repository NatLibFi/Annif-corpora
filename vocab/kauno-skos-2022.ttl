yso:p27273 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2013-12-19"^^xsd:date ;
    skos:altLabel "koulunkäynnin ohjaajat"@fi ;
    skos:broader yso:p30185 ;
    skos:closeMatch allars:Y46386,
        ysa:Y196305 ;
    skos:hiddenLabel "special needs teaching assistant"@en,
        "koulunkäynnin ohjaaja"@fi,
        "koulunkäynninohjaaja"@fi ;
    skos:inScheme kauno: ;
    skos:note "Koulunkäynninohjaajat ovat koulunkäynnin ja aamu- ja iltapäivätoiminnan ammattitutkinnon suorittaneita. He voivat sijoittua koulunkäynnin ohjaustehtäviin esimerkiksi esiopetuksessa ja perusopetuksessa, aamu- ja iltapäivätoiminnan ja vapaa-ajantoiminnan tehtäviin sekä toimia avustajana päivähoidossa.(http://www.takk.fi/?id=koulutusesite&esite=1252&koulutus=12622). Tehtävän nimikkeestä on ollut kiistaa, vanhempi nimike on koulunkäyntiavustajat (http://suomenkuvalehti.fi/jutut/kotimaa/uusi-ammattiryhma-koulussa-tehtavan-nimikkeesta-riita/)"@fi,
        "Personer som avlagt yrkesexamen för skolgång och morgon- och eftermiddagsverksamhet, och som arbetar med uppgifter som gäller handledning av skolgång vid t.ex. förskole- och grundundervisning, handledning av morgon-, eftermiddags- och fritidsverksamhet, eller assistans i dagvård. Den tidigare benämningen skolgångsbiträde används även i många sammanhang."@sv ;
    skos:prefLabel "special needs teaching assistants"@en,
        "koulunkäynninohjaajat"@fi,
        "skolgångshandledare"@sv ;
    skos:related yso:p16602 ;
    yso-meta:singularAltLabel "koulunkäynnin ohjaaja"@fi ;
    yso-meta:singularPrefLabel "special needs teaching assistant"@en,
        "koulunkäynninohjaaja"@fi .

