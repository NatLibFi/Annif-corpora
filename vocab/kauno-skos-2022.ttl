yso:p30142 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "pentatoninen säveljärjestelmä"@fi ;
    skos:broader yso:p12382 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2002002627>,
        allars:Y51969,
        ysa:Y214723 ;
    skos:definition "Viidestä sävelestä koostuvaan asteikkoon perustuva säveljärjestelmä, joka on yleinen eurooppalaisessa kansanmusiikissa, mutta myös monissa ei-eurooppalaisissa kulttuureissa ja mm. antiikin Kreikassa. Viisisäveljärjestelmät muodostuvat joko pelkistä kokosävelaskelista (antihemitoninen) tai myös puolisävelaskelista (hemitoninen)."@fi,
        "Tonsystem som grundar sig på en skala bestående av fem toner, och som är vanlig i europeisk folkmusik, men också i många icke-europeiska kulturer och bl.a. i antikens Grekland."@sv ;
    skos:hiddenLabel "pentatonic scale"@en ;
    skos:inScheme kauno: ;
    skos:prefLabel "pentatonic scales"@en,
        "viisisäveljärjestelmä"@fi,
        "pentatonik"@sv ;
    yso-meta:singularPrefLabel "pentatonic scale"@en .

yso:p30143 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:broader yso:p3064 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh99012468>,
        allars:Y51975,
        ysa:Y214661 ;
    skos:definition "Yhdysvalloissa käyttöön otettu nimitys jazzmusiikille, jossa kokoonpanossa oli sellaisia omatekoisia soittimia, kuten pesulauta ja paperilla päällystetty kampa. Nimityksen ottivat käyttöön myös eräät Isossa-Britanniassa 1950-luvulla syntyneet yhtyeet, jotka yhdistivät musiikissaan jazzia, bluesia ja folkia."@fi,
        "Musikgenre med influenser av jazz, blues och folk. Ursprungligen togs benämningen i bruk för ensemblen med hemmagjorda instrument, såsom tvättbräden."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "skiffle"@en,
        "skiffle"@fi,
        "skiffle"@sv .

yso:p30144 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "lick"@sv ;
    skos:broader yso:p3960 ;
    skos:closeMatch allars:Y51968,
        ysa:Y214544 ;
    skos:definition "Varsinkin kitaramusiikin yhteydessä käytettävä soittotekninen termi, jolla tarkoitetaan soittajalle tunnusomaista, improvisaation osana käytettyä lyhyttä motiivia."@fi,
        "Spelteknisk term i samband med gitarrmusik, med vilken avses ett kort melodiskt motiv använt som en del av improvisation och som är karakteristiskt för en instrumentalist."@sv ;
    skos:hiddenLabel "lick"@en,
        "lick"@fi ;
    skos:inScheme kauno: ;
    skos:prefLabel "licks"@en,
        "licksit"@fi,
        "licks"@sv ;
    yso-meta:singularPrefLabel "lick"@en,
        "lick"@fi .

yso:p30159 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-08"^^xsd:date ;
    skos:broader yso:p1515 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85098452>,
        allars:Y51811,
        ysa:Y215277 ;
    skos:definition "Basso-ostinatolle rakentuva muunnelmateos."@fi,
        "Variationsverk som bygger på basso ostinato."@sv ;
    skos:hiddenLabel "passacaglia (compositions)"@en,
        "passacaglia"@fi,
        "passacaglia"@sv ;
    skos:inScheme kauno: ;
    skos:note "Käsitettä käytetään vain sävellyksistä, jotka säveltäjä on nimennyt passacaglioiksi."@fi,
        "Begreppet används bara om kompositioner, vars kompositör namngett passacaglia."@sv ;
    skos:prefLabel "passacaglias (compositions)"@en,
        "passacagliat"@fi,
        "passacaglior"@sv ;
