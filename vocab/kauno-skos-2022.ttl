        yso-meta:Concept ;
    dc:source "http://www.albedoc.com/eft/?gclid=CJe7ktHxk7wCFYlF3godi0IASA#.UuDT9BD8I-U"@fi ;
    dct:created "2014-01-23"^^xsd:date ;
    skos:altLabel "EFT-menetelmät"@fi,
