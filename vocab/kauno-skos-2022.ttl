yso:p2889 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2004-03-15"^^xsd:date ;
    skos:altLabel "hiljaiset signaalit"@fi ;
    skos:broader yso:p25766 ;
    skos:closeMatch allars:Y29976,
        ysa:Y130060 ;
    skos:hiddenLabel "weak signal"@en,
        "heikko signaali"@fi,
        "hiljainen signaali"@fi,
        "svag signal"@sv ;
    skos:inScheme kauno: ;
    skos:note "Sellainen ilmiö tai tapahtuma, joka ei välttämättä tapahtuessaan vaikuta tärkeältä, mutta jolla on tulevaisuuden kannalta tärkeä tai jopa ratkaiseva merkitys. Heikko signaali on ensimmäinen ilmaus muutoksesta tai se voi olla juuri se sysäys, joka muuttaa ratkaisevasti tapahtumien kulkua."@fi,
        "Fenomen eller händelse som inte nödvändigtvis verkar viktig då den äger rum, men som kan ha en viktig eller t.o.m. avgörande betydelse för framtiden. En svag signal kan vara en första yttring av förändring eller just den impuls som på ett avgörande sätt ändrar händelsers förlopp."@sv ;
    skos:prefLabel "weak signals"@en,
        "heikot signaalit"@fi,
        "svaga signaler"@sv ;
    skos:related yso:p2890 ;
    yso-meta:singularAltLabel "hiljainen signaali"@fi ;
    yso-meta:singularPrefLabel "weak signal"@en,
        "heikko signaali"@fi,
        "svag signal"@sv .

