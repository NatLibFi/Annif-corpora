yso:p38310 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2019-03-07"^^xsd:date ;
    skos:altLabel "indie pop"@fi,
        "indie pop"@sv ;
    skos:broader yso:p2969 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2015000867>,
        allars:Y53220,
        ysa:Y506952 ;
    skos:definition "Indierockille läheinen tyylilaji, joka alun perin liittyi punkin myötä syntyneeseen tee se itse -eetokseen ja itsenäisiin levy-yhtiöihin. Äänimaisemaltaan indiepop on indierockiin ja punkiin verrattuna rauhallisempi ja vähemmän aggressiivinen."@fi,
        "Musikstil besläktad med indierock, som från början förknippades med självständiga skivbolag och gör det själv-etoset som uppstått i samband med punk. Till sin ljudmiljö är indiepop lugnare och mindre aggressiv i jämförelse med indierock och punk."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "indie pop"@en,
        "indiepop"@fi,
        "indiepop"@sv ;
    skos:related yso:p21503 .

yso:p38311 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2019-03-11"^^xsd:date ;
    skos:altLabel "repetitive music"@en,
        "repetitiivinen musiikki"@fi,
        "repetitiomusiikki"@fi,
        "toistomusiikki"@fi,
        "repetitionsmusik"@sv,
        "repetitiv musik"@sv ;
    skos:broader yso:p18434 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh86001706>,
        allars:Y53144,
        ysa:Y233573 ;
    skos:definition "1960-luvulla syntyneen minimalistisen tyylisuuntauksen piiriin luettava taidemusiikki, jolle on ominaista toisteisuus ja tarkoituksellisen yksinkertaistettu rytminen, melodinen ja harmoninen sävelkieli."@fi,
        "Konstmusik som räknas till den minimalistiska stilriktningen som uppkom på 1960-talet, för vilken redundans och ett medvetet förenklat, rytmiskt, melodiskt och harmoniskt tonspråk är karakteristiskt."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "minimal music"@en,
        "minimalistinen musiikki"@fi,
        "minimalistisk musik"@sv ;
    skos:related yso:p18549 .

