    skos:hiddenLabel "paraphrase (music)"@en,
        "oopperaparafraasi"@fi,
        "parafraasi (sävellykset)"@fi,
        "paraphrase de concert"@fi,
        "réminiscence"@fi,
        "parafras"@sv,
        "parafras (kompositioner)"@sv,
        "parafras (musik)"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "paraphrases (music)"@en,
        "parafraasit (sävellykset)"@fi,
        "parafraser (kompositioner)"@sv ;
    skos:related yso:p1514 ;
    skos:scopeNote "Koska rajanveto parafraasin, kollaasin ja muuten lainaavan sävellyksen välillä on vaikeaa, käsitettä käytetään vain teoksista, jotka säveltäjä ja hakuteokset määrittelevät parafraaseiksi."@fi,
        "Eftersom gränsdragning mellan parafras, collage och i övrigt lånad komposition är svår, används begreppet endast om verk som kompositören eller uppslagsverk anger som parafraser."@sv ;
    yso-meta:singularAltLabel "oopperaparafraasi"@fi,
