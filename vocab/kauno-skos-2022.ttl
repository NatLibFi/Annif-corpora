yso:p12069 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2003-06-16"^^xsd:date ;
    skos:altLabel "serviceproducenter"@sv ;
    skos:broader yso:p8823 ;
    skos:closeMatch allars:Y29600,
        ysa:Y125688 ;
    skos:hiddenLabel "service producer"@en,
        "palveluntuottaja"@fi,
        "serviceproducent"@sv,
        "tjänsteproducent"@sv ;
    skos:inScheme kauno: ;
    skos:note "Organisaatio tai yksittäinen henkilö, joka saa aikaan palveluja. Sosiaali- ja terveydenhuollossa palveluntuottajista erotetaan yleensä varsinaiset palvelua antavat organisaatioiden osat tai yksittäiset henkilöt eli palvelunantajat. Esimerkiksi yliopistollinen sairaala voi olla palveluntuottaja ja sen silmäpoliklinikka palvelunantaja."@fi,
        "Organisation eller enskild person som åstadkommer tjänster. Inom social- och hälsovård skiljer man vanligen de delar av organisationer eller enskilda personer som ger de egentliga tjänsterna, alltså tillhandahållare av service från tjänsteproducenterna. T.ex. ett universitetssjukhus kan vara tjänsteproducent och dess ögonpoliklinik kan vara tillhandahållare av tjänsten."@sv ;
    skos:prefLabel "service producers"@en,
        "palveluntuottajat"@fi,
        "tjänsteproducenter"@sv ;
    yso-meta:singularAltLabel "serviceproducent"@sv ;
    yso-meta:singularPrefLabel "service producer"@en,
        "palveluntuottaja"@fi,
        "tjänsteproducent"@sv .

