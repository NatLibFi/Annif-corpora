yso:p25875 a skos:Concept,
        yso-meta:Concept ;
    dc:source "http://www.tse.fi/FI/tietoa/suunnittelu/Documents/TuKKKaikuiskoulutusstrategia2006-2010.pdf"@fi ;
    dct:created "2012-03-01"^^xsd:date ;
    skos:broader yso:p16486 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2003008908>,
        allars:Y43391,
        ysa:Y184590 ;
    skos:hiddenLabel "adult student"@en,
        "aikuisopiskelija"@fi ;
    skos:inScheme kauno: ;
    skos:note "An adult student is a person who has already completed vocational or tertiary degree studies and pursuits to further develop their knowledge and skills. The term also covers open university students who have already completed secondary level studies."@en,
        "Aikuisopiskelija on henkilö, joka on jo suorittanut jonkin ammatillisen tai korkeakoulututkinnon ja pyrkii tämän jälkeen (usein työn ohessa) kehittämään edelleen tietojaan ja taitojaan. Aikuisopiskelijaksi luetaan tässä myös toisen asteen koulutuksen suorittanut avoimen yliopiston opiskelija"@fi,
        "Person som redan har avlagt någon yrkes- eller högskoleexamen och som efter detta (ofta vid sidan om arbete) försöker vidareutveckla sina kunskaper och färdigheter. Till vuxenstuderande räknas också studerande vid öppna universitetet, som avlagt en andra stadiets utbildning."@sv ;
    skos:prefLabel "adult students"@en,
        "aikuisopiskelijat"@fi,
        "vuxenstuderande"@sv ;
    yso-meta:singularPrefLabel "adult student"@en,
        "aikuisopiskelija"@fi .

