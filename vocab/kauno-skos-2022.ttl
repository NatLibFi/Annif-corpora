yso:p29828 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-07"^^xsd:date ;
    skos:broader yso:p3063 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85015108>,
        allars:Y51883,
        ysa:Y214419 ;
    skos:definition "Yhdysvalloissa 1930- ja 1940-luvuilla kehittynyt valkoisen väestön akustinen ja perinteisiin nojautuva maaseutumusiikin tyyli, jota ei ole tarkoitettu tanssittavaksi. Bluegrassin alkuperäiseen esityskokoonpanoon kuuluu vain kielisoittimia, lähinnä banjo, mandoliini, kitara, dobro, viulu ja kontrabasso."@fi,
        "Akustisk stil inom landsbygdsmusik utvecklad bland den vita befolkningen och ur dess traditioner i USA på 1930- och 1940-talen. Till den ursprungliga besättningen i bluegrass hör bara stränginstrument, främst banjo, mandolin, gitarr, dobro, violin och kontrabas."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "bluegrass"@en,
        "bluegrass"@fi,
        "bluegrass"@sv ;
    skos:related yso:p29945 .

