yso:p9975 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: CD-Facta"@fi ;
    dct:created "1995-10-26"^^xsd:date ;
    skos:broader yso:p418 ;
    skos:closeMatch allars:Y17426,
        ysa:Y104318 ;
    skos:hiddenLabel "émigré"@en,
        "emigrantti"@fi,
        "emigrant"@sv ;
    skos:inScheme kauno: ;
    skos:note "A person who has been forced to leave their own country, typically for political or religious reasons. Mainly used in historical contexts, for contemporary use see [http://www.yso.fi/onto/yso/p6458]."@en,
        "Tarkoittaa henkilöä, joka uskonnollisista tai poliittisista syistä on joutunut jättämään kotimaansa. Käytetään lähinnä historiallisessa yhteydessä, muissa tapauksissa käytetään käsitettä [http://www.yso.fi/onto/yso/p6458]."@fi,
        "Avser personer som av religiösa eller politiska orsaker har tvingats lämna sitt hemland. Används främst i historisk bemärkelse, i annat fall används begreppet [http://www.yso.fi/onto/yso/p6458]."@sv ;
    skos:prefLabel "émigrés"@en,
        "emigrantit"@fi,
        "emigranter"@sv ;
    skos:related yso:p20631,
        yso:p6165,
        yso:p6457,
        yso:p6458,
