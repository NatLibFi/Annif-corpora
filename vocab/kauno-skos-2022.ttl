yso:p24749 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2011-02-28"^^xsd:date ;
    skos:altLabel "Semitic-Hamitic languages"@en,
        "haamilaiset kielet"@fi,
        "seemiläis-haamilaiset kielet"@fi,
        "hamitiska språk"@sv,
        "hamito-semitiska språk"@sv,
        "semitisk-hamitiska språk"@sv ;
    skos:broader yso:p556 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85002020>,
        allars:Y40250,
        ysa:Y177625 ;
    skos:hiddenLabel "Afroasiatic language"@en,
        "Semitic-Hamitic language"@en,
        "afroaasialainen kieli"@fi,
        "haamilainen kieli"@fi,
        "seemiläis-haamilainen kieli"@fi,
        "afroasiatiskt språk"@sv,
        "hamitiskt språk"@sv,
        "hamito-semitiskt språk"@sv,
        "semitisk-hamitiskt språk"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p14142,
        yso:p14794,
        yso:p15608,
        yso:p19606,
        yso:p26211,
        yso:p38727,
        yso:p4265 ;
    skos:note "Nimitys on otettu sanastoon 2011, aiemmin on käytetty termiä seemiläis-haamilaiset kielet. Aikaisemmin afroaasialaiset kielet jaettiin seemiläis-haamilaisiksi kieliksi, mutta nimityksestä on luovuttu, koska kielten jaolla seemiläisiin ja haamilaisiin kieliin ei ole kielitieteellistä perustetta."@fi,
        "Begrepp i vokabulären sedan 2011, tidigare användes termen semitisk-hamitiska språk. Tidigare indelades afroasiatiska språk i semitisk-hamitiska språk, men användningen av den benämningen har upphört eftersom det inte finns någon språkvetenskaplig grund för indelning i semitiska och hamitiska språk."@sv ;
    skos:prefLabel "Afroasiatic languages"@en,
        "afroaasialaiset kielet"@fi,
        "afroasiatiska språk"@sv ;
    skos:related yso:p19079 ;
    yso-meta:singularAltLabel "Semitic-Hamitic language"@en,
        "haamilainen kieli"@fi,
        "seemiläis-haamilainen kieli"@fi,
        "hamitiskt språk"@sv,
        "hamito-semitiskt språk"@sv,
        "semitisk-hamitiskt språk"@sv ;
    yso-meta:singularPrefLabel "Afroasiatic language"@en,
        "afroaasialainen kieli"@fi,
        "afroasiatiskt språk"@sv .

