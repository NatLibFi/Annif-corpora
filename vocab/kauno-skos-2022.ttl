yso:p7672 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@en ;
    dct:created "1986-10-01"^^xsd:date ;
    skos:broader yso:p115 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85010576>,
        <http://id.loc.gov/authorities/subjects/sh85031235>,
        allars:Y22642,
        ysa:Y99508 ;
    skos:definition "Esim. filosofian alueella tutkittu yksilön kullakin hetkellä kokemien aistimusten, elämysten, tunteiden, muistikuvien ja ajatusten kokonaisuus, tai yksilön tietoisuus itsestään ja ympäristöstään."@fi,
        "Upplevd helhet av sinnesförnimmelser, upplevelser, känslor, minnesbilder och tankar som en individ har vid en tidpunkt, eller individens medvetenhet om sig själv och sin omgivning. Studeras t.ex. inom filosofi."@sv ;
    skos:inScheme kauno: ;
    skos:narrower kauno:p216,
        kauno:p4509,
        yso:p10,
        yso:p112,
        yso:p23046,
        yso:p25283,
        yso:p25466 ;
    skos:note "In the context of e.g. philosophy, the whole of a person’s feelings, sensations, recollections and thoughts, or a person’s consciousness of themselves and their surroundings."@en ;
    skos:prefLabel "consciousness (mental properties)"@en,
        "tietoisuus"@fi,
        "medvetenhet"@sv ;
    skos:related yso:p21791,
        yso:p24919,
        yso:p7065,
        yso:p7066,
        yso:p9293 .

