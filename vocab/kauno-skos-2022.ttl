yso:p8502 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:altLabel "negro spirituaalit"@fi,
        "negrospirituaalit"@fi,
        "negro spirituals"@sv,
        "spiritualer"@sv ;
    skos:broader yso:p8501 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85126782>,
        allars:Y26666,
        ysa:Y101449 ;
    skos:definition "Yhdysvaltain afroamerikkalaisen väestön perinteinen suullisena perimätietona välittynyt hengellinen laulu, jollaisia on laulettu alun perin ilman säestystä ja myöhemmin myös urkujen, harmonin tms. säestyksellä, usein jumalanpalvelusten yhteydessä. Spirituaaleina pidetään myös näiden laulujen taidemusiikin omaisia sovituksia."@fi,
        "Andlig sång som traditionellt vidareförts muntligt bland den afroamerikanska befolkningen i USA, och som ursprungligen sjungits utan ackompanjemang, men senare och ackompanjerat av orgel, harmonium e.d., ofta i samband med gudstjänster. Som spirituals räknas och konstmusikaliska arrangemang av dessa sånger."@sv ;
    skos:hiddenLabel "spiritual (songs)"@en,
