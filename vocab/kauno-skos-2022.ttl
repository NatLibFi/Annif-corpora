yso:p25989 a skos:Concept,
        yso-meta:Concept ;
    dc:source "http://global.finland.fi/gender/ngo/peruskasitteet.htm"@fi ;
    dct:created "2012-03-14"^^xsd:date ;
    skos:altLabel "socialt kön"@sv ;
    skos:broader yso:p5291 ;
    skos:closeMatch allars:Y43655,
        ysa:Y184925 ;
    skos:inScheme kauno: ;
    skos:note "Sosiaalinen sukupuoli määrittelee miesten ja naisten välisiä sosiaalisia eroja. Näitä eroja tytöt ja pojat oppivat sosialisaation myötä, eri kulttuureissa eri tavalla. Naisen ja miehen identiteetit muodostuvat erilaisiksi, koska ympäröivä yhteisö asettaa jo syntymästä saakka tytöille ja pojille erilaisia odotuksia."@fi,
        "Det sociala könet bestämmer sociala skillnader mellan kvinnor och män. Sådana skillnader lär sig flickor och pojkar genom socialisering, i olika kulturer på olika sätt. Kvinnliga och manliga identiteter utformas olika, eftersom den omgivande gemenskapen redan från födseln lägger olika förväntningar på flickor och pojkar."@sv ;
    skos:prefLabel "social gender"@en,
        "sosiaalinen sukupuoli"@fi,
        "genus"@sv ;
    skos:related yso:p38322,
        yso:p9137,
        yso:p928,
        yso:p929 .

