yso:p14614 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2001-03-27"^^xsd:date ;
    skos:altLabel "dance-pop"@fi,
        "eurodance"@fi,
        "tanssipop"@fi,
        "danspop"@sv,
        "eurodance"@sv ;
    skos:broader yso:p29932 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh00000588>,
        allars:Y16748,
        ysa:Y113587 ;
    skos:definition "1990-luvulla suosituksi tullut elektronisen tanssimusiikin laji, jota voi luonnehtia housen ja teknon helpotetuksi versioksi. Laulu ja melodisuus ovat tärkeämmässä osassa kuin muussa elektronisessa tanssimusiikissa. Tunnetuin dancen alagenre on eurodance, joka sisältää usein myös räppiä."@fi,
        "Genre inom elektronisk dansmusik som är en lättare version av house och techno och som blev populär på 1990-talet. Sång och melodiskhet är mer betonad än i annan elektronisk dansmusik. Den mest kända underarten av dance är eurodance, som ofta också innehåller rap."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "dance (music)"@en,
        "dance"@fi,
        "dance"@sv ;
    skos:related yso:p12374,
        yso:p12377,
        yso:p14336,
        yso:p28047,
        yso:p29894,
        yso:p29901,
        yso:p30024,
        yso:p30149 ;
    skos:scopeNote "Käsitettä käytetään myös klubimusiikista vaikutteita ammentavien listapop-artistien tuotannon tanssittavimmasta osasta."@fi,
        "Begreppet används också om den del av listpopartisters produktion som influeras av dans och klubbmusik."@sv .

