        allars:Y52517,
        ysa:Y505729 ;
    skos:definition "Kokonaan kaiverretuilla puulevyillä painettu kirja, jossa on tekstiä tai kuvia ja tekstiä. Vanhimmat tunnetut eurooppalaiset laattakirjat ovat 1400-luvun puolivälin tienoilta ja sisällöltään yleensä uskonnollisia. -- Tieteen termipankki"@fi,
        "Bok tryckt med hela träplattor, på vilka man skurit ut text eller bild och text i relief. De äldsta kända europeiska blockböckerna är från mitten av 1400-talet och till sitt innehåll vanligen religiösa."@sv ;
    skos:hiddenLabel "block book"@en,
        "blokkikirja"@fi,
        "laattakirja"@fi,
        "blockbok"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "block books"@en,
        "laattakirjat"@fi,
        "blockböcker"@sv ;
    skos:related yso:p15822,
        yso:p21323,
        yso:p6528 ;
    yso-meta:singularAltLabel "blokkikirja"@fi ;
    yso-meta:singularPrefLabel "block book"@en,
        "laattakirja"@fi,
        "blockbok"@sv .

