        allars:Y46246,
        ysa:Y196893 ;
    skos:hiddenLabel "emotional freedom technique"@en,
        "EFT-menetelmä"@fi,
        "EFT-tekniikka"@fi,
        "Emotionional Freedom Technique"@fi,
        "tunteiden vapautustekniikka"@fi ;
    skos:inScheme kauno: ;
    skos:note "Yhdysvaltalaisen Gary Craigin 1980-luvulla kehittämä hoitotekniikka, jossa kehon akupisteiden, ns. meridiaanien päätepisteiden taputtelusarjalla yhdessä muistutuslauseiden (afformaatiot) kanssa helpotetaan tunteiden vapauttamista, fyysisiä oireita ja toimintakyvyn palauttamista."@fi,
        "Behandlingsmetod utvecklad av amerikanen Gary Craig på 1980-talet, vilken inbegriper knackningar på meridianpunkter i kroppen och samtidig fokusering på patientens problem."@sv ;
    skos:prefLabel "emotional freedom techniques"@en,
        "EFT"@fi,
        "emotional freedom techniques"@sv ;
    skos:related yso:p391 ;
