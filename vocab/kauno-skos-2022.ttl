yso:p4181 a skos:Concept,
        yso-meta:Concept ;
    dc:source "SFS:n SI-opas"@fi ;
    dct:created "1993-01-12"^^xsd:date ;
    skos:broader yso:p1400 ;
    skos:closeMatch allars:Y26933,
        ysa:Y106831 ;
    skos:hiddenLabel "quantity"@en,
        "suure"@fi,
        "storhet"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p2101,
        yso:p38865,
        yso:p4180 ;
    skos:note """Suure on ominaisuus, joka voidaan laadultaan tunnistaa ja määrältään mitata. Luonnonilmiöiden mitattavat ominaisuudet ovat suureita. Suureita ovat aika, pituus, massa, voima, taajuus, resistanssi, tasokulma ym. Niiden mittayksiköt ovat sekunti, metri, kilogramma, newton, hertsi, ohmi, radiaani ym. Suureen arvo on lukuarvon
ja mittayksikön tulo. Esimerkki: pituus on viisi metriä. Tässä pituus on suure, viisi lukuarvo ja metri yksikkö."""@fi,
        "En storhet är en egenskap som till sin kvalitet kan igenkännas och till sin kvantitet mätas. Egenskaper som kan mätas hos naturfenomen är storheter. Storheter är tid, längd, massa, kraft, frekvens, resistans, vinkel m.m. Deras motsvarande måttenheter är sekund, meter, kilogram, newton, hertz, ohm, radian m.m. En storhets värde är talvärdets och måttenhetens produkt. Exempel: längden är fem meter. Här är längden storhet, fem talvärde och meter enhet."@sv ;
    skos:prefLabel "quantities"@en,
        "suureet"@fi,
        "storheter"@sv ;
    skos:related yso:p3586,
        yso:p4366,
        yso:p4499 ;
    yso-meta:singularPrefLabel "quantity"@en,
        "suure"@fi,
        "storhet"@sv .

