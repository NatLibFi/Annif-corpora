    skos:closeMatch allars:Y18667,
        ysa:Y106149 ;
    skos:inScheme kauno: ;
    skos:note "Sovinnolla prosessioikeudessa tarkoitetaan sopimusta, jolla henkilöt ratkaisevat riita-asiansa tuomion sijasta sovittelemalla. Se voi tapahtua joko ennen oikeusriidan vireille tuloa tuomioistuimessa taikka sitten tuomioistuinkäsittelyn aikana"@fi,
        "Förlikning inom processrätt avser ett avtal med vilket personer löser sina tvistemål genom att åstadkomma förlikning, i stället för genom dom. Förlikningen kan ske antingen innan en rättstvist blir anhängig vid domstol eller under domstolsbehandling."@sv ;
    skos:prefLabel "settlement (resolution)"@en,
        "sovinto (oikeustiede)"@fi,
        "förlikning"@sv ;
    skos:related yso:p22853,
        yso:p3562,
        yso:p3563 .

