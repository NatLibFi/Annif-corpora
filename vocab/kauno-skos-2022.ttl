        kaunometa:Concept ;
    rdfs:comment "Selvästi lapsille suunnatut pelit, jotka ovat yleensä aikuisille liian helppoja. Digitaalisissa peleissä lastenpelit sisältävät usein lapsille suunnattuja söpöjä pelihahmoja"@fi,
        "Spel som uttryckligen riktar sig till barn och i allmänhet är alltför lätta för vuxna. I digitala spel innehåller barnspel ofta söta spelfigurer som riktar sig till barn"@sv ;
    skos:broader yso:p6062 ;
    skos:exactMatch yso:p26478 ;
    skos:inScheme kauno: ;
    skos:prefLabel "lastenpelit"@fi,
        "barnspel"@sv ;
    kaunometa:facet kaunometa:section_3 .

