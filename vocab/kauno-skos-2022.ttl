yso:p20138 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Taiteen pikkujättiläinen"@fi ;
    dct:created "2000-03-07"^^xsd:date ;
    skos:broader yso:p20653 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh94005350>,
        allars:Y24625,
        ysa:Y112805 ;
    skos:inScheme kauno: ;
    skos:note "1960-luvulla syntynyt taidesuunta, jonka mukaan luomisprosessi on tärkeämpi kuin sen tuote, taideteos. Prosessitaiteilijat käyttävät usein materiaaleinaan muuttuvia luonnonelementtejä ja järjestävät tilaisuuksia, joissa taideteos valmistetaan."@fi,
        "Konstinriktning som uppstod på 1960-talet och som framhäver den skapande processen framom det färdiga konstverket. Konstnärerna använder sig ofta av föränderliga naturelement och arrangerar tillställningar där själva konstverket skapas."@sv ;
    skos:prefLabel "process art"@en,
        "prosessitaide"@fi,
        "processkonst"@sv .

