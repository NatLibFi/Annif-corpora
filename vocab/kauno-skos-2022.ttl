    skos:broader yso:p8823 ;
    skos:closeMatch allars:Y51973,
        ysa:Y214741 ;
    skos:definition "Henkilö, joka viime kädessä vastaa äänitteen valmistumisesta ja julkaisemisesta tietyn sisältöisenä ja tietyssä muodossa. Äänitetuottajan rooli teknisten ja taiteellisten ratkaisujen tekemisessä vaihtelee tapaus- ja genrekohtaisesti."@fi,
        "Den person som i sista hand ansvarar för produktion och utgivning av en ljudinspelning med ett visst innehåll och i ett visst format. Ljusinspelningsproducentens roll gällande de tekniska och konstnärliga lösningarna varierar från fall till fall och beroende på genre."@sv ;
    skos:hiddenLabel "record producer"@en,
        "levytuottaja"@fi,
        "äänitetuottaja"@fi,
        "ljudinspelningsproducent"@sv,
        "skivproducent"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "record producers"@en,
        "äänitetuottajat"@fi,
        "ljudinspelningsproducenter"@sv ;
    yso-meta:singularAltLabel "levytuottaja"@fi,
        "skivproducent"@sv ;
    yso-meta:singularPrefLabel "record producer"@en,
        "äänitetuottaja"@fi,
        "ljudinspelningsproducent"@sv .

