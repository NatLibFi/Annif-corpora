yso:p26210 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-05-09"^^xsd:date ;
    skos:altLabel "khakasiska"@sv ;
    skos:broader yso:p2805 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85072140>,
        allars:Y45081,
        ysa:Y185976 ;
    skos:inScheme kauno: ;
    skos:note "A Turkic language spoken by the Khakas people, who mainly live in the southern Siberian Khakas Republic, or Khakassia, in Russia"@en,
        "Hakassia puhuu äidinkielenään noin 60 000 ihmistä (v. 2010) , joista suurin osa asuu Hakassiassa, jonka toinen virallinen kieli hakassi myös on. Lisäksi hakassin kielen puhujia asuu jonkin verran ympäröivillä alueilla, kuten Tuvassa, Kemerovon alueella ja Evenkiassa."@fi,
        "Språk som talas i främst Chakassien och därtill omkringliggande områden såsom Tuva, Kemerovo och Evenkien."@sv ;
    skos:prefLabel "Khakass language"@en,
        "hakassin kieli"@fi,
        "chakassiska"@sv .

yso:p26211 a skos:Concept,
