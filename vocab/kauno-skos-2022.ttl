    skos:broader kauno:p2245,
        kauno:p396 ;
    skos:inScheme kauno: ;
    skos:prefLabel "kuvatehostekirjat"@fi,
        "bildeffektsböcker"@sv ;
    skos:related kauno:p1567 ;
    kaunometa:facet kaunometa:section_3 .

