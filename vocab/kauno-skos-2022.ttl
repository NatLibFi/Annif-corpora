        "danssvit"@sv,
        "kassation"@sv,
        "partita"@sv,
        "svit"@sv,
        "svit (kompositioner)"@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p10242,
        yso:p29908,
        yso:p30061 ;
    skos:prefLabel "suites (compositions)"@en,
