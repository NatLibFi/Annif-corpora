yso:p15859 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p10920 ;
    skos:closeMatch allars:Y18975,
        ysa:Y102559 ;
    skos:definition "Kisällilaulu on päivänpolitiikkaan ja ajankohtaisiin uutistapahtumiin humoristisesti kantaa ottava kansanomainen pilkkalaulu. Kisällilaulut kehittyivät 1920-luvulla suomalaisen työväenliikkeen nuorison harrastustoiminnan osana."@fi,
        "Avser folklig nidvisa som på ett humoristiskt sätt tar ställning till dagspolitiken och aktuella nyhetshändelser. Dessa sånger uppkom på 1920-talet som en del av den finska arbetarrörelsens fritidsverksamhet för ungdomar."@sv ;
    skos:hiddenLabel "kisällilaulu"@fi,
        "gesällvisa"@sv ;
    skos:inScheme kauno: ;
    skos:note "A type of political folk song."@en ;
    skos:prefLabel "kisällilaulut"@en,
        "kisällilaulut"@fi,
        "gesällvisor"@sv ;
    skos:related yso:p13243 ;
    yso-meta:singularPrefLabel "kisällilaulu"@fi,
        "gesällvisa"@sv .

