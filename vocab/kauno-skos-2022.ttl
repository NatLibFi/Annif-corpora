yso:p1669 a skosext:DeprecatedConcept,
        skos:Concept ;
    owl:deprecated true ;
    skos:inScheme kauno:deprecatedconceptscheme ;
    skos:note "käsitteet, jotka ovat riippumattomia muihin käsiteryhmiin kuuluvista käsitteistä; ontologian muut käsitteet voivat viitata abstrakteihin, mutta abstraktit voivat viitata vain toisiinsa (luokka sisältää vain suureet ja yksiköt (sekä avaruutta/euklidista tilaa tms. ilmentävät käsitteet) eli luokan nimitys ei viittaa abstrakteihin käsitteisiin sanan tavanomaisessa merkityksessä"@fi,
        "Begrepp som är oberoende av begrepp som hör till andra begreppsgrupper; ontologins andra begrepp kan hänvisa till abstrakt, men abstrakt kan hänvisa endast till varandra (klassen innehåller endast storheter och enheter samt begrepp som uttrycker rymd/euklidiskt tillstånd e.d.), således hänvisar klassens benämning inte till abstrakta begrepp i ordets vanliga bemärkelse"@sv ;
    skos:prefLabel "abstract"@en,
        "abstrakti"@fi,
        "abstrakt"@sv ;
    skos:scopeNote "deprecated on 09.06.2014" ;
    skos:topConceptOf kauno:deprecatedconceptscheme .

