yso:p1807 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:altLabel "muzak"@fi,
        "muzak"@sv ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh87006893>,
        <http://www.wikidata.org/entity/Q1353390>,
        allars:Y15659,
        ysa:Y103624 ;
    skos:definition "Liikekeskuksissa, työpaikoilla, lentokentillä yms. julkisissa tiloissa soitettava musiikki, jonka tarkoituksena on usein edistää haluttua mielialaa tai tunnelmaa (esim. ostohalukkuus, tarmokkuus työssä, rauhallisuus tms.). Taustamusiikki on yleensä staattista, toisteista ja tasaisen harmonista, joten siihen ei kiinnitetä tietoista huomiota."@fi,
        "Musik som spelas i köpcentrum, på arbetsplatser, flygplatser e.d offentliga platser, och vars syfte är att främja en önskad sinnesstämning eller stämning. Bakgrundsmusik är vanligen statisk, upprepande och jämt harmonisk, så att man inte ägnar den någon medveten uppmärksamhet."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "background music"@en,
        "taustamusiikki"@fi,
        "duogášmusihkka"@se,
        "bakgrundsmusik"@sv ;
    skos:related yso:p29508,
        yso:p37819,
        yso:p39818 ;
    skos:scopeNote "Käsitettä käytetään vain tässä merkityksessä. Arkikielessä yleistä termiä \"muzak\" ei  käytetä, koska se on tavaramerkillä suojattu kaupallinen termi."@fi,
        "Begreppet används endast i denna betydelse. Termen \"muzak\" som också är vanlig används inte, eftersom det är ett registrerat varumärke."@sv .

