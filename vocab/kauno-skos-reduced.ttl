        <http://www.wikidata.org/entity/Q572901>,
        allars:Y53144,
        ysa:Y233573 ;
    skos:definition "1960-luvulla syntyneen minimalistisen tyylisuuntauksen piiriin luettava taidemusiikki, jolle on ominaista toisteisuus ja tarkoituksellisen yksinkertaistettu rytminen, melodinen ja harmoninen sävelkieli."@fi,
        "Konstmusik som räknas till den minimalistiska stilriktningen som uppkom på 1960-talet, för vilken redundans och ett medvetet förenklat, rytmiskt, melodiskt och harmoniskt tonspråk är karakteristiskt."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "minimal music"@en,
        "minimalistinen musiikki"@fi,
        "minimalisttalaš musihkka"@se,
        "minimalistisk musik"@sv .

