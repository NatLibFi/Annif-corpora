yso:p29795 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1997-09-30"^^xsd:date ;
    skos:altLabel "mellanspel"@sv ;
    skos:broader yso:p1515 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh95001194>,
        allars:Y51754,
        ysa:Y214506 ;
    skos:definition "Renessanssiajan näytelmien väliin sijoitettu musiikillinen välinäytös. Intermediot olivat erityisen tärkeitä Firenzessä 1500-luvulla. 1600-luvulla intermedio muuntui oopperan väliosaksi. Rinnakkaisia ilmiöitä olivat masque Englannissa ja ballet de cour Ranskassa."@fi,
        "Musikaliskt mellanspel placerat mellan akterna i renässanstidens skådespel. Intermedier var särskilt viktiga i Florens på 1500-talet. Under 1600-talet omvandlades intermediet till en mellandel i opera. Parallella fenomen var masque i England och ballet de cour i Frankrike."@sv ;
    skos:hiddenLabel "intermedio"@en,
        "intermedium"@sv ;
    skos:inScheme kauno: ;
    skos:note "Ei pidä sekoittaa käsitteeseen [http://www.yso.fi/onto/yso/p10244]."@fi,
        "Bör ej sammanblandas med begreppet [http://www.yso.fi/onto/yso/p10244]."@sv ;
    skos:prefLabel "intermedi"@en,
        "intermediot"@fi,
        "intermedier"@sv ;
    skos:related yso:p5187 ;
    yso-meta:singularPrefLabel "intermedio"@en,
        "intermedium"@sv .

