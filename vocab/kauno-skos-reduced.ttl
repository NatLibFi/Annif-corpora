yso:p7508 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Tulevaisuudentutkimus : perusteet ja sovelluksia"@fi ;
    dct:created "2002-11-21"^^xsd:date ;
    skos:altLabel "SSM"@fi,
        "Soft systems methodology"@fi,
        "SSM"@sv,
        "mjuk systemmetodologi"@sv ;
    skos:broader yso:p7509 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q613474>,
        allars:Y42629,
        ysa:Y121799 ;
    skos:inScheme kauno: ;
    skos:note "Toimintatutkimukseen pohjautuva menetelmä, joka periaatteiltaan pohjautuu prof. Peter Checklandin vuonna 1985 kehittämään ja 1990-luvulla uudelleenjäsentämään työskentelytapaan. Tulevaisuudentutkimuksessa menetelmän avulla pyritään löytämään yhteys päätöksentekoyksiköiden (kuten yritysten ja kuntien) tavoitteiden asettelun, tulevaisuuden tutkimuksen tuottamien visioiden ja nykyisyyttä koskevan itseymmärryksen välille. Tästä tiedosta synnytetään näkemys muutosprosessista, jolla päätöksentekoyksikkö voi varautua erilaisiin mahdollisiin tulevaisuuksiin"@fi,
        "Metod som grundar sig på aktionsforskning och det arbetssätt som professor Peter Checkland utvecklade 1985 och omstrukturerade på 1990-talet."@sv ;
    skos:prefLabel "Soft systems methodology"@en,
        "pehmeä systeemimetodologia"@fi,
        "Soft systems methodology"@se,
        "Soft systems methodology"@sv .

