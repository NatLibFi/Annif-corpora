kauno:p155 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Kielitoimiston sanakirja"@fi,
        "Nationalencyklopedin"@sv ;
    rdfs:comment """1. väliintulo, asioihin puuttuminen.\r
2. pol., oik. puuttuminen toisen valtion asioihin (pakkoa t. sen uhkaa käyttäen).\r
3. vars. lääk. toimenpide jolla pyritään vaikuttamaan yksilön t. jnk ryhmän käyttäytymiseen t. terveydentilaan."""@fi,
        """1. inom processrätten möjlighet för någon som inte är part att inträda i en rättegång och delta i denna för att skydda sina egna intressen.\r
2. ingripande i pågående konflikt med militära eller icke-militära medel.\r
3. inom medicinen vetenskapligt samlingsbegrepp som omfattar förebyggande eller behandlande åtgärder."""@sv ;
    skos:broader yso:p14 ;
    skos:inScheme kauno: ;
    skos:prefLabel "interventio"@fi,
        "intervention"@sv ;
    skos:related kauno:p1279,
        kauno:p1625,
        kauno:p4212,
        kauno:p4230 ;
    kaunometa:facet kaunometa:section_1 .

