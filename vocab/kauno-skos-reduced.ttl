    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85120146>,
        <http://www.wikidata.org/wiki/Q1147354> ;
    skos:definition "A chant or hymn sung in Latin before or after the Alleluia during the liturgical celebration of the Eucharist."@en,
        "Alleluia-sävelmän edellä tai jälkeen laulettava latinankielinen ehtoollishymni. Tunnetuimmat näistä noin vuosina 850–1150 muotoutuneista hymneistä ovat Dies irae, Lauda Sion, Veni Sancte Spiritus ja Victimae paschali laudes."@fi,
        "Nattvardshymn på latin som sjungs före eller efter Alleluia-kompositionen. De mest kända av dessa är Dies irae, Lauda Sion, Veni Sancte Spiritus och Victimae paschali laudes."@sv ;
    skos:hiddenLabel "sekvenssi (hymnit)"@fi ;
    skos:inScheme kauno: ;
    skos:prefLabel "sequences (hymns)"@en,
        "sekvenssit (hymnit)"@fi,
        "sekvenssat (hymnat)"@se,
        "sekvenser (hymner)"@sv ;
    skos:related yso:p6553 ;
    yso-meta:singularPrefLabel "sekvenssi (hymnit)"@fi .

