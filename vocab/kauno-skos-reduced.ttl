yso:p26202 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-04-24"^^xsd:date ;
    skos:closeMatch <http://www.wikidata.org/entity/Q216053>,
        allars:Y44521,
        ysa:Y185600 ;
    skos:inScheme kauno: ;
    skos:note "Form of fashion that originated in 18th century France. Today referring to expensive and high-quality handmade fashion items that can be regarded as works of art."@en,
        "Ranskassa 1700-luvulla alkunsa saanut muotitaide, jolla nykyisin viitataan kalliisiin ja korkeatasoisiin, mittatilaustyönä ja pääosin käsintehtyihin muotiluomuksiin, joita voidaan pitää taideteoksina."@fi,
        "Modekonst som fick sin början i 1700-talets Frankrike och med vilken man numera hänvisar till dyra, högkvalitativa, måttbeställda och i huvudsak handgjorda modekreationer som kan anses vara konstverk."@sv ;
    skos:prefLabel "haute couture"@en,
        "haute couture"@fi,
        "haute couture"@se,
        "haute couture"@sv .

