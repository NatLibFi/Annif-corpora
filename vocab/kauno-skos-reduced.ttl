kauno:p90 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Kielitoimiston sanakirja"@fi ;
    rdfs:comment """1. korvaus, palkkio, tyydyke, hyvike.\r
Tal. tilin kreditpuolelle tehty merkintä.\r
2. hyvittäminen.\r
Hyvittää: antaa hyvitystä, korvata; sovittaa.\r
Tal.\r
a. maksaa, suorittaa; ottaa huomioon osasuorituksena jstak maksusta.\r
b. merkitä tilin kreditpuolelle, kreditoida."""@fi ;
    skos:altLabel "gottgörelse"@sv ;
    skos:broader yso:p14 ;
