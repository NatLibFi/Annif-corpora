yso:p29942 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1997-09-30"^^xsd:date ;
    skos:altLabel "dark ambient"@en,
        "experimental ambient"@en,
        "dark ambient"@fi,
        "experimental ambient"@fi,
        "dark ambient"@se,
        "experimental ambient"@se,
        "dark ambient"@sv,
        "experimental ambient"@sv ;
    skos:broader yso:p23218 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2006005853>,
        <http://www.wikidata.org/entity/Q193207>,
        allars:Y51876,
        ysa:Y214390 ;
    skos:definition "1970-luvulla syntynyt populaarimusiikkityyli, jossa on pyritty luomaan yleensä elektronisin soittimin erilaisia, tavallisesti harmonisia ääniympäristöjä. Puhtaassa ambient-musiikissa rytmillä on hyvin pieni merkitys. Käsitettä suositellaan käytettäväksi lähinnä vain vuoden 1975 jälkeen syntyneestä musiikista."@fi,
        "Populärmusikstil som uppkom på 1970-talet och i vilken olika, vanligtvis harmoniska, ljudmiljöer skapas med främst elektroniska instrument. I ren ambientmusik har rytm endast liten betydelse. Begreppet används främst om musik efter 1975."@sv ;
    skos:inScheme kauno: ;
    skos:note "Termi esiintyy myös osana 1990-luvulla rave-kulttuurin johdannaisena luoduista genreistä käytettäviä nimityksiä (esim. ambient dub, ambient house, ambient pop, ambient techno). Näiden yhteydessä suositellaan käytettäväksi niiden yläkäsitteitä (dub, house, popmusiikki, tekno jne.)."@fi,
        "Ordet förekommer också som en del i olika genren skapade på 1990-talet ur ravekulturen (t.ex. ambient dub, ambient house, ambient pop, ambient techno). I samband med dessa används deras överordnade begrepp (dub, house, popmusik, techno etc.)."@sv ;
    skos:prefLabel "ambient music"@en,
        "ambient"@fi,
        "ambient"@se,
        "ambient"@sv ;
    skos:related yso:p19199,
        yso:p29901,
        yso:p29953,
        yso:p30069,
        yso:p30116 .

