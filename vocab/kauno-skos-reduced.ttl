kauno:p5837 a skos:Concept,
        kaunometa:Concept ;
    rdfs:comment "Selvästi lapsille suunnatut pelit, jotka ovat yleensä aikuisille liian helppoja. Digitaalisissa peleissä lastenpelit sisältävät usein lapsille suunnattuja söpöjä pelihahmoja"@fi,
        "Spel som uttryckligen riktar sig till barn och i allmänhet är alltför lätta för vuxna. I digitala spel innehåller barnspel ofta söta spelfigurer som riktar sig till barn"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "lastenpelit"@fi,
        "barnspel"@sv ;
    kaunometa:facet kaunometa:section_3 .

kauno:p5838 a skos:Concept,
        kaunometa:Concept ;
    dc:source "YSA"@fi,
        "Översatt från den finska definitionen"@sv ;
    rdfs:comment "Tarkoittaa henkilöitä, jotka eivät ole identiteetiltään tai ruumiilliselta olemukseltaan yksiselitteisesti miehiä tai naisia."@fi,
        "Avser personer som till sin identitet eller fysiska habitus inte är entydigt män eller kvinnor."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "sukupuolivähemmistöt"@fi,
        "könsminoriteter"@sv ;
    kaunometa:facet kaunometa:section_6 .

