kauno:p4364 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Kielitoimiston sanakirja"@fi ;
    rdfs:comment """a. yliluonnollinen, selittämätön asia t. tapahtuma, jumalallinen tunnusteko.\r
b. ihmetystä herättävä, hämmästyttävä esine t. asia, merkillisyys, erikoisuus, kumma.\r
c. hämmästys, kummastus, kumma, ihmetys.\r
d. pula, kiipeli, hätä, ahdinko.\r
e. vahvistussanana."""@fi ;
    skos:altLabel "mirakel"@sv ;
    skos:inScheme kauno: ;
    skos:narrower kauno:p3649,
        kauno:p4224,
