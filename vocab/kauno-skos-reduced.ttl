yso:p29776 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "cityblues"@fi,
        "cityblues"@sv ;
    skos:broader yso:p4482 ;
    skos:closeMatch allars:Y51890,
        ysa:Y214436 ;
    skos:definition "1920- ja 1930-luvuilla kaupungeissa kehittynyt bluesin tyylilaji, joka on yleensä akustista pienyhtyebluesia selvin yhteyksin jazziin. City bluesin edustajia ovat mm. Big Maceo, Tampa Red, ja Sonny Boy Williamson I."@fi,
        "Underart till blues som utvecklats i städerna på 1920- och 1930-talen och som vanligen är akustisk och spelas i små band, samt har klara band till jazz. Företrädare för city blues är t.ex. Big Maceo, Tampa Red och Sonny Boy WIlliamson I."@sv ;
    skos:inScheme kauno: ;
    skos:note "Myöhempien aikojen kaupunkilaisbluesista käytetään käsitettä [http://www.yso.fi/onto/yso/p29946]."@fi,
        "Om senare tiders stadsblues används begreppet [http://www.yso.fi/onto/yso/p29946]."@sv ;
    skos:prefLabel "city blues"@en,
        "city blues"@fi,
        "city blues"@se,
        "city blues"@sv ;
    skos:related yso:p29783,
        yso:p29946,
        yso:p4483 .

