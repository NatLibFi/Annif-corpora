yso:p1690 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Kielikello 1/2000"@fi ;
    dct:created "1986-09-01"^^xsd:date ;
    skos:altLabel "maakunnalliset liitot"@fi,
        "maakunnan liitot"@fi,
        "maakuntien liitot"@fi,
        "förbund på landskapsnivå"@sv,
        "landskapens förbund"@sv,
        "landskapsförbunden"@sv ;
    skos:broader yso:p719 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q18690690>,
        allars:Y21778,
        ysa:Y97152 ;
    skos:hiddenLabel "regional council"@en,
        "maakunnallinen liitto"@fi,
        "maakunnan liitto"@fi,
        "maakuntaliitto"@fi,
        "maakuntien liitto"@fi,
        "eatnangottelihttu"@se ;
    skos:inScheme kauno: ;
    skos:note "Regional planning authorities and regional councils were merged together in 1993."@en,
        "Alun perin maakuntaliitot ovat olleet alueensa sivistys- ja talouselämän kehittämiseksi toimivia järjestöjä. Uudet maakuntaliitot (vuodesta 1993 lähtien) on muodostettu yhdistämällä vanhat maakuntaliitot ja seutukaavaliitot. Niille kuuluvat aluekehitystehtävät ja -vastuu. Suomen kussakin 19 maakunnassa on oma liittonsa, jolla on maakuntavaltuusto, -hallitus ja -johtaja. Maakuntaliittojen yhdyselimenä toimii Suomen kuntaliitto"@fi,
        "Ursprungligen har landskapsförbunden varit organisationer som verkar för att utveckla bildningslivet och det ekonomiska livet på sina områden. De nya förbunden (fr.o.m. år 1993) har bildats genom att förena de gamla landskapsförbunden med regionplansförbunden. Till dem hör uppgifter och ansvar för regional utveckling. Vart och ett av Finlands 19 landskap har ett eget förbund, med landskapsfullmäktige, -styrelse och -direktör. Som samordnande organ fungerar Finlands Kommunförbund."@sv ;
    skos:prefLabel "regional councils"@en,
        "maakuntaliitot"@fi,
        "eatnangottelihtut"@se,
        "landskapsförbund"@sv ;
    skos:related yso:p13216,
        yso:p718 ;
    yso-meta:singularAltLabel "maakunnallinen liitto"@fi,
        "maakunnan liitto"@fi,
        "maakuntien liitto"@fi ;
    yso-meta:singularPrefLabel "regional council"@en,
        "maakuntaliitto"@fi,
        "eatnangottelihttu"@se .

