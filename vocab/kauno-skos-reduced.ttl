        "Avser särskilt unga vuxnas oförmåga att klara av vardagliga sysslor och göromål, tex. skötsel av hemmet."@sv ;
    skos:broader yso:p115,
        yso:p28822 ;
    skos:inScheme kauno: ;
    skos:prefLabel "uusavuttomuus"@fi,
        "nyhjälplöshet"@sv ;
