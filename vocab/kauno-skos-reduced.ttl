yso:p13985 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Vanne, R., Julkinen talous ja sukupolvet"@fi ;
    dct:created "2001-04-04"^^xsd:date ;
    skos:altLabel "generationsbokföring"@sv ;
    skos:broader yso:p2692 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh96009625>,
        allars:Y18920,
        ysa:Y113689 ;
    skos:hiddenLabel "generationsräkenskap"@sv ;
    skos:inScheme kauno: ;
    skos:note "Tarkoittaa menetelmää, jolla selvitetään sitä, ovatko nykyiset ja tulevat sukupolvet eri asemassa suhteessa julkiseen talouteen. Indikaattoreina ovat nettoverot koko sukupolven elinkaarelta. Nettoverot ovat sukupolven elinkaarensa aikana maksamien verojen ja sen saamien tulonsiirtojen ja julkisten palvelujen erotus."@fi,
        "Metod för att utreda om nuvarande och kommande generationer befinner sig i olika ställning i förhållande till den offentliga ekonomin. Som indikatorer fungerar nettoskatterna från hela generationens levnadslopp. Med nettoskatterna avses skillnaden mellan de skatter som generationen under sin levnad betalat och de inkomstöverföringar och offentliga tjänster som generationen fått."@sv ;
    skos:prefLabel "generational accounting"@en,
        "sukupolvitilinpito"@fi,
        "generationsräkenskaper"@sv ;
    yso-meta:singularPrefLabel "generationsräkenskap"@sv .

