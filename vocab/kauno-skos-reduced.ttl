yso:p27133 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@en ;
    dct:created "2013-03-26"^^xsd:date ;
    skos:altLabel "riimilliset kansanlaulut"@fi,
        "finska enstrofingar"@sv ;
    skos:broader yso:p2842 ;
    skos:closeMatch allars:Y45618,
        ysa:Y191922 ;
    skos:definition "A type of rhymed stanzaic folksong in Finland."@en,
        "1800-luvulla yleistynyt suomalainen, alkuaan yksisäkeistöinen, kahdesta keskenään loppusoinnullisesta säeparista muodostunut lyyrissävyinen kansanlaulu. Ensimmäinen säepari sisältää tavallisesti yleisluontoisen mieleen johdatuksen, yleensä luontoaiheisen, johon jälkisäepari liittää laulajan omakohtaisen kokemuksen."@fi,
        "Finsk lyrisk folksång som blev allmän på 1800-talet. Den bestod urpsrungligen av en strof och två verspar med slutrim sinsemellan. Det första versparet innehöll vanligen en inledning av allmän karaktär, ofta med naturen som ämne, med vilket det efterföljande versparet sammankopplade en egen erfarenhet hos sångaren."@sv ;
    skos:hiddenLabel "rekilaulu"@en,
        "rekilaulu"@fi,
        "finsk enstrofing"@sv ;
    skos:inScheme kauno: ;
    skos:note "Det finns inget etablerat motsvarande begrepp på svenska."@sv ;
    skos:prefLabel "rekilaulut"@en,
        "rekilaulut"@fi,
        "rekilaulut"@se,
        "rekilaulut"@sv ;
    yso-meta:singularAltLabel "finsk enstrofing"@sv ;
    yso-meta:singularPrefLabel "rekilaulu"@en,
        "rekilaulu"@fi .

