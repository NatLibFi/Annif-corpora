kauno:p2738 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Yrjö Hosiaisluoma: Kirjallisuuden sanakirja"@fi ;
    rdfs:comment "Pääjuonen oheen limitetty kertomus, jolla on usein temaattisesti ja rakenteellisesti merkittävä tehtävä varsinkin romaaneissa... Sisäkertomukset ovat poikkeamia pääjuonesta ja siten omiaan hidastamaan kerrontaa, mutta niiden avulla voidaan luoda monikerroksisempi ja monivivahteisempi kuva maailmasta."@fi ;
    skos:altLabel "sisäiskertomus"@fi,
        "sisäkertomus"@fi,
        "kärnberättelse"@sv ;
    skos:broader kauno:p2048 ;
    skos:inScheme kauno: ;
    skos:prefLabel "sisäkertomukset"@fi,
        "kärnberättelser"@sv ;
    skos:related kauno:p2345 ;
    kaunometa:facet kaunometa:section_1 .

