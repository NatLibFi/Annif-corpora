yso:p14026 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Opetus, oppiminen, vuorovaikutus"@fi ;
    dct:created "2002-03-13"^^xsd:date ;
    skos:altLabel "luonnontieto"@fi,
        "ympäristötieto"@fi,
        "miljökunskap"@sv,
        "naturkunskap"@sv ;
    skos:closeMatch allars:Y34297,
        ysa:Y118240 ;
    skos:inScheme kauno: ;
    skos:note "Oppiainekokonaisuus ympäristö- ja luonnontieto mainittiin ensimmäisen kerran vuoden 1994 peruskoulun opetussuunnitelman perusteissa (Opetushallitus 1994). Ympäristö- ja luonnontiedossa yhdistyvät osittain aikaisempien ympäristöä ja luontoa käsitelleiden oppiaineiden (biologian, kansalaistaidon, maantiedon ja ympäristöopin) tavoitteet ja sisällöt"@fi,
        "Läroämneshelhet som nämndes första gången i grunderna för läroplanen för den grundläggande utbildningen från år 1994. I detta ämne förenades delvis målsättningarna och innehållen i de tidigare läroämnena som behandlade miljö och natur (biologi, medborgarfärdighet, geografi, omgivningslära)."@sv ;
    skos:prefLabel "environment and nature studies"@en,
        "ympäristö- ja luonnontieto"@fi,
        "biras- ja luonddudiehtu"@se,
        "miljö- och naturkunskap"@sv .

