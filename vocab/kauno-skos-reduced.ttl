yso:p38124 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2018-10-01"^^xsd:date ;
    skos:altLabel "Abbasidien dynastia"@fi,
        "abbasiddynastin"@sv ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85000061>,
        <http://www.wikidata.org/entity/Q4437641>,
        allars:Y52848,
        ysa:Y506038 ;
    skos:hiddenLabel "Abbasid"@en,
        "abbasidi"@fi ;
    skos:inScheme kauno: ;
    skos:note "Abbasidit hallitsivat kalifaattia omaijadien dynastian jälkeen v. 750-1258 Bagdadissa. Myöhemmin abbasideilla oli nimellinen asema kalifeina mamelukkien alaisuudessa Kairossa vuoteen 1517."@fi,
        "Kalifdynasti som regerade efter umayyaderna,  år 750-1258 i Bagdad. Senare hade abbasiderna en formell ställning under mamlukerna i Kairo fram till år 1517."@sv ;
    skos:prefLabel "Abbasids"@en,
        "abbasidit"@fi,
        "abbasider"@sv ;
    skos:related yso:p17368,
        yso:p39597 ;
    yso-meta:singularPrefLabel "Abbasid"@en,
        "abbasidi"@fi .

