yso:p27011 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2012-08-21"^^xsd:date ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1371360>,
        allars:Y45140,
        ysa:Y187674 ;
    skos:inScheme kauno: ;
    skos:note "A movement in arts and literature that aims to secure the originality and future of a small people or language group by combining new technology and artistic experimentations to traditional folklore"@en,
        "Taiteellinen ja kirjallinen aatesuuntaus, jossa pienen kansan tai kieliryhmän omaleimaisuus ja tulevaisuus pyritään turvaamaan yhdistelemällä kansanperinteeseen uusia taiteellisia muotokokeiluja ja uutta tekniikkaa"@fi,
        "Konstnärlig och litterär rörelse, inom vilken man försöker trygga ett litet folks eller en liten språkgrupps särprägling och framtid genom att förena folklig tradition med nya konstnärliga formexperiment och ny teknik."@sv ;
    skos:prefLabel "ethnofuturism"@en,
        "etnofuturismi"@fi,
        "etnofuturisma"@se,
        "etnofuturism"@sv .

