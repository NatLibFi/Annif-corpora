yso:p17110 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2002-04-24"^^xsd:date ;
    skos:broader yso:p4163 ;
    skos:closeMatch allars:Y17617,
        ysa:Y118888 ;
    skos:inScheme kauno: ;
    skos:note "Muuntokoulutus on tutkintoon johtavaa koulutusta, jota ohjelmaluonteisena järjestetään yleensä jollekin ryhmälle.  Muuntokoulutuksessa muunnetaan aikaisemmin suoritettuja saman tai lähialojen tutkintoja uusiksi tutkinnoiksi (esim. teknikosta insinööriksi). Opiskelijoiden aikaisempia opintoja voidaan lukea hyväksi tavallista aikuiskoulutusta enemmän. Koulutuksen tuloksena on tutkinto, joka voi olla korkeampi tai samantasoinen kuin opiskelijan aikaisempi tutkinto"@fi,
        "Utbidlning som leder till examen och som med programkaraktär vanligen ordnas för någon grupp. I utbildningen modifieras tidigare avlagda examina i samma eller närliggande branscher till nya examina (t.ex. från tekniker till ingenjör). De studerandes tidigare studier kan räknas till godo mer än vanlig vuxenutbildning. Utbildningen kan leda till en examen som är högre än eller på samma nivå med den studerandes tidigare examen."@sv ;
    skos:prefLabel "retraining and upgrading of qualifications"@en,
        "muuntokoulutus"@fi,
        "examensinriktad fortbildning"@sv .

