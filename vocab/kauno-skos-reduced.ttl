kauno:p2309 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Yrjö Hosiaisluoma: Kirjallisuuden sanakirja"@fi,
        "Webb-Bella"@sv ;
    rdfs:comment "Tyyli ja kerrontatekniikka, jossa muuten realistiseen, objektiiviseen ja raportoivaan kerrontaan on yhdistetty tai rinnastettu fantastisia, surrealistisia ym. vaikeasti selitettäviä aineksia."@fi,
        "Används om verk, där berättartekniken gör bruk av att kombinera realistiska och fantastiska element och stilar."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "maaginen realismi"@fi,
        "magisk realism"@sv ;
    skos:related kauno:p1781,
