yso:p11851 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Ekholm, Elina (toim.). Monikulttuurisia yrittäjiä"@fi ;
    dct:created "1999-04-23"^^xsd:date ;
    skos:altLabel "sosiaalinen yrittäjyys"@fi ;
    skos:closeMatch <http://www.wikidata.org/entity/Q1071015>,
        allars:Y26436,
        ysa:Y112004 ;
    skos:hiddenLabel "social enterprise"@en,
        "sosiaalinen yritys"@fi,
        "sosiála fitnodat"@se,
        "socialt företag"@sv ;
    skos:inScheme kauno: ;
    skos:note "Sosiaaliset yritykset voidaan jakaa kahteen ryhmään. 1) Yritykset, jotka integroivat työelämään henkilöitä, joilla on heikko ammatillinen pätevyys tai jotka ovat muuten syrjäytyneet perinteisestä palkkatyöstä. Tällaiset yritykset ovat yleensä yhdistyksiä tai osuuskuntia. 2) Yritykset, jotka tarjoavat sosiaalipalveluja heikommassa asemassa oleville sekä syrjäytyneille ryhmille että yksilöille"@fi,
        "Sociala företag kan indelas i två grupper. 1) Företag som i arbetslivet integrerar personer med svag yrkeskompetens eller personer som annars har utslagits från traditionellt lönearbete. Sådana företag är vanligen föreningar eller andelslag. 2) Företag som erbjuder socialtjänster till individer eller grupper som är marginaliserade och som befinner sig i en svag ställning."@sv ;
    skos:prefLabel "social enterprises"@en,
        "sosiaaliset yritykset"@fi,
        "sosiála fitnodagat"@se,
        "sociala företag"@sv ;
    skos:related yso:p11350,
        yso:p11852,
        yso:p24434 ;
    yso-meta:singularPrefLabel "social enterprise"@en,
        "sosiaalinen yritys"@fi,
        "sosiála fitnodat"@se,
        "socialt företag"@sv .

