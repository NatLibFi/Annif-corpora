yso:p123 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Encyclopaedia iuridica Fennica. 4"@fi ;
    dct:created "2000-10-05"^^xsd:date ;
    skos:altLabel "organizational crimes"@en ;
    skos:closeMatch allars:Y20118,
        ysa:Y112993 ;
    skos:hiddenLabel "organisational crime"@en,
        "organizational crime"@en,
        "organisaatiorikos"@fi,
        "organisašuvdnarihkus"@se ;
    skos:inScheme kauno: ;
    skos:note "Organisaatio- eli yhteisörikollisuudella tarkoitetaan sellaista rikollisuutta, joka edellyttää rikoksenteon taustaksi itsenäisen organisaation olemassaolon. Organisaatiorikollisuus on puhtaan yksilörikollisuuden vastakohta. Organisaatiolla tarkoitetaan tässä yhteydessä erityisesti talouselämän ja julkisen vallan organisaatioita. Tässä mielessä suurin osa talousrikoksista on organisaatiorikoksia."@fi,
        "Kriminalitet som förutsätter en självständig organisations existens. Med organisation avses i detta sammanhang särskilt organisationer inom ekonomiskt liv och offentlig makt. I detta avseende är en stor del av de ekonomiska brotten organisationsbrott. Motsats till individuell kriminalitet."@sv ;
    skos:prefLabel "organisational crimes"@en,
        "organisaatiorikokset"@fi,
        "organisašuvdnarihkkosat"@se,
        "organisationsbrott"@sv ;
    yso-meta:singularAltLabel "organizational crime"@en ;
    yso-meta:singularPrefLabel "organisational crime"@en,
        "organisaatiorikos"@fi,
        "organisašuvdnarihkus"@se .

