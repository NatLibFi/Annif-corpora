yso:p16785 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1990-04-11"^^xsd:date ;
    skos:broader yso:p16228 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q2496949>,
        allars:Y26560,
        ysa:Y103429 ;
    skos:definition "Marssi, jolle säveltäjä on antanut tällaisen nimen (marche funèbre, marcia funebre), sekä marssi, joka tiedetään tarkoitetun surumarssiksi. Surumarssilla ei ole mitään objektiivisia ominaisuuksia, mutta yleensä niihin liitetään hidas tempo, harras tunnelma ja suurten dynaamisten vaihteluiden välttäminen."@fi,
        "Komposition som kompositören namngett sorgmarsch (marche funèbre, marcia funebre), eller som man vet är avsedd för detta ändamål. Vanligen präglas sorgmarscher av långsamt tempo, from stämning och avsaknad av stora dynamiska växlingar."@sv ;
    skos:hiddenLabel "dead march"@en,
        "surumarssi"@fi,
        "sorgmarsch"@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "dead marches"@en,
        "surumarssit"@fi,
        "sorgmarscher"@sv ;
    skos:related yso:p16784 ;
    yso-meta:singularPrefLabel "dead march"@en,
        "surumarssi"@fi,
        "sorgmarsch"@sv .

