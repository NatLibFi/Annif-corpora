yso:p12050 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Mäkelä, J., Kuinka yhteys löytyy?"@fi ;
    dct:created "2005-01-10"^^xsd:date ;
    skos:broader yso:p11765 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q7782532>,
        allars:Y36463,
        ysa:Y135351 ;
    skos:inScheme kauno: ;
    skos:note "Theraplay on lyhytkestoinen vuorovaikutusterapia, jonka tarkoitus on rakentaa ja vahvistaa lapsen ja häntä hoitavan aikuisen välistä vuorovaikutusta sekä synnyttää ja lujittaa heidän kiintymyssuhdettaan. Theraplay syntyi 1960-luvulla Yhdysvalloissa Chicagossa lasten syrjäytymistä ehkäisevässä projektissa."@fi,
        "Kortvarig samspelsterapi, med syftet att bygga upp och förstärka sampelet mellan ett barn och en vuxen som sköter barnet, samt skapa och förstärka ankytningsrelationen mellan dessa. Theraplay började användas på 1960-talet i Chicago i Förenta staterna inom ett projekt för förebyggande av barns marginalisering."@sv ;
    skos:prefLabel "Theraplay"@en,
        "Theraplay"@fi,
        "Theraplay"@se,
        "Theraplay"@sv .

