kauno:p5174 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Verkko-Kaunokki"@fi,
        "Webb-Bella"@sv ;
    rdfs:comment "Inuitien asuma-alue levittäytyy nauhamaisena ketjuna Alaskan pohjoisosista pitkin mantereen pohjoisrannikkoa aina Labradorin niemimaalle saakka ja edelleen Baffininsaaren kautta Grönlannin länsi- ja itärannikolle."@fi,
        "Inuiternas boningsområde breder ut sig från Alaskas nordligaste delar längs fastlandets norra kust ända till Labradorhalvön och vidare via Baffinön till Grönlands väst- och östkust."@sv ;
    skos:altLabel "inuiitit"@fi ;
    skos:broader yso:p487 ;
    skos:inScheme kauno: ;
    skos:prefLabel "inuitit"@fi,
        "inuiter"@sv ;
    skos:related kauno:p5175 ;
    kaunometa:facet kaunometa:section_6 .

kauno:p5175 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Verkko-Kaunokki"@fi,
        "Webb-Bella"@sv ;
    rdfs:comment "Jupikit asuvat Etelä- ja Lounais-Alaskassa, Koillis-Siperian rannikolla ja Beringinmeressä sijaitsevalla St. Lawrencen saarella."@fi,
        "Yupikerna bor i södra och sydvästra Alaska, på nordöstra Sibiriens kust och på ön St. Lawrence i Berings hav."@sv ;
    skos:broader yso:p487 ;
    skos:inScheme kauno: ;
    skos:prefLabel "jupikit"@fi,
        "yupiker"@sv ;
    skos:related kauno:p5174 ;
