yso:p27583 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Wikipedia"@fi ;
    dct:created "2014-03-07"^^xsd:date ;
    skos:altLabel "flipped classroom"@fi,
        "käänteinen luokkahuone"@fi,
        "flippad undervisning"@sv,
        "omvänd undervisning"@sv,
        "omvänt klassrum"@sv ;
    skos:broader yso:p22964 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q80267>,
        allars:Y46348,
        ysa:Y197328 ;
    skos:inScheme kauno: ;
    skos:note "Käänteinen opetus (tai käänteinen luokkahuone, engl. flipped classroom) on monimuoto-opetuksen muoto, jossa käytetään apuna Internetissä olevia opetusmateriaaleja, jolloin varsinaisella oppitunnilla jää enemmän aikaa opettajan ja opiskelijoiden väliselle vuorovaikutukselle. Tavoitteena on saada opiskelijat tutustumaan uuteen asiaan ensin itsenäisesti, minkä jälkeen asian käsittelyä jatketaan yhdessä oppitunnilla."@fi,
        "En typ av flerformsundervisning, i vilken läromaterial på internet används som hjälp, och som ger mer tid för interaktion mellan lärare och elever. Målet är att eleverna först självständigt bekantar sig med en ny sak och därefter fortsätter man gemensamt behandlingen av saken under lektionerna."@sv ;
    skos:prefLabel "flipped classroom"@en,
        "käänteinen opetus"@fi,
        "flippat klassrum"@sv ;
    skos:related yso:p14924 .

