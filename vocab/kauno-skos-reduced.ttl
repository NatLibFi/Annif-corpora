yso:p1980 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Ripatti, M., Arvid Järnefelt kasvatusajattelijana"@fi ;
    dct:created "2002-10-21"^^xsd:date ;
    skos:broader yso:p1584 ;
    skos:closeMatch allars:Y42800,
        ysa:Y121289 ;
    skos:inScheme kauno: ;
    skos:note "Koulun uudistusliike, joka kehittyi 1800-luvun lopulla ja 1900-luvun alussa Saksassa ja Yhdysvalloissa. Se oli murroskauden reformiliike, jonka tarkoituksena oli uudistaa koulua muuttuvassa yhteiskunnallisessa tilanteessa ja pyrkiä vastaamaan teollistumisen, kaupungistumisen ja siirtolaisuuden aiheuttamiin ongelmiin."@fi,
        "Reformrörelse av skolan, som utvecklades i slutet av 1800-talet och början av 1900-talet i Tyskland och Förenta staterna. Rörelsens syfte var att förnya skolan i en föränderlig samhällssituation och försöka svara på de problem som industrialisering, urbanisering och migration orsakade."@sv ;
    skos:prefLabel "reform pedagogy"@en,
        "reformipedagogiikka"@fi,
        "reforbmapedagogihkka"@se,
        "reformpedagogik"@sv .

