kauno:p2321 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Kielitoimiston sanakirja"@fi,
        "Nationalencyklopedin"@sv ;
    rdfs:comment "menettely jossa työntekijät voivat tahdostaan siirtyä määräaikaisesti toisiin tehtäviin"@fi,
        "ett sätt att organisera arbetet så att varje anställd arbetar med samma arbetsuppgifter bara under en begränsad tid, varefter han skiftar till en annan uppgift. Rotationstiden kan variera från några minuter, när det är frågan om enahanda rutinbetonade arbetsuppgifter, till månader, när det gäller mer intellektuellt betonat arbete."@sv ;
    skos:altLabel "henkilökierto"@fi,
        "personalrotation"@sv ;
    skos:broader yso:p1051 ;
    skos:inScheme kauno: ;
    skos:prefLabel "työkierto"@fi,
        "arbetsrotation"@sv ;
