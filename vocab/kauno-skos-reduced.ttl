        "Tema"@sv .

kaunometa:Concept a owl:Class ;
    rdfs:label "KAUNO Concept"@en,
        "KAUNO-käsite"@fi,
        "KAUNO-begrepp"@sv ;
    rdfs:subClassOf owl:Class,
        skos:Concept .

