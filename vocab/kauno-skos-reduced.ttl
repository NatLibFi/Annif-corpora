yso:p30142 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:altLabel "pentatoninen säveljärjestelmä"@fi ;
    skos:broader yso:p12382 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh2002002627>,
        allars:Y51969,
        ysa:Y214723 ;
    skos:definition "Viidestä sävelestä koostuvaan asteikkoon perustuva säveljärjestelmä, joka on yleinen eurooppalaisessa kansanmusiikissa, mutta myös monissa ei-eurooppalaisissa kulttuureissa ja mm. antiikin Kreikassa. Viisisäveljärjestelmät muodostuvat joko pelkistä kokosävelaskelista (antihemitoninen) tai myös puolisävelaskelista (hemitoninen)."@fi,
        "Tonsystem som grundar sig på en skala bestående av fem toner, och som är vanlig i europeisk folkmusik, men också i många icke-europeiska kulturer och bl.a. i antikens Grekland."@sv ;
    skos:hiddenLabel "pentatonic scale"@en ;
    skos:inScheme kauno: ;
    skos:prefLabel "pentatonic scales"@en,
        "viisisäveljärjestelmä"@fi,
        "pentatonalaš skálá"@se,
        "pentatonik"@sv ;
    yso-meta:singularPrefLabel "pentatonic scale"@en .

