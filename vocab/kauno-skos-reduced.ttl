yso:p4485 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1989-01-01"^^xsd:date ;
    skos:altLabel "African-American music"@en ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85001968>,
        <http://www.wikidata.org/entity/Q388207>,
        allars:Y14972,
        ysa:Y94518 ;
    skos:definition "Musiikinlajit, jotka ovat syntyneet ja muotoutuneet afrikkalaisten musiikkikulttuureiden sulautuessa amerikkalaiseen kulttuuriin aina afrikkalaisten orjien tuonnista 1400-luvulta 1800-luvulle ja sen jälkeen afrikkalaista syntyperää olevien amerikkalaisten keskuudessa."@fi,
        "Musikstilar som har uppkommit vid den afrikanska musikkulturens sammansmältning med den amerikanska kulturen, ända från det att afrikanska slavar fördes till landet till efter det bland amerikaner med afrikansk härkomst."@sv ;
    skos:inScheme kauno: ;
    skos:narrower kauno:p2729,
        yso:p14995,
        yso:p15777,
        yso:p29816,
        yso:p29990,
