yso:p8488 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1987-01-01"^^xsd:date ;
    skos:broader yso:p2371 ;
    skos:closeMatch <http://www.wikidata.org/entity/Q11895072>,
        allars:Y21787,
        ysa:Y97150 ;
    skos:definition "Suomen maakuntien epävirallisia nimikkolauluja, joita esitetään usein kansallislaulun tapaan yhteislauluna juhlatilaisuuksissa."@fi,
        "Inofficiella sånger för landskap i Finland, som ofta framförs på samma sätt som nationalsånger som gemensam sång vid festtillfällen."@sv ;
    skos:hiddenLabel "provincial anthem"@en,
        "maakuntalaulu"@fi,
        "landskapssång"@sv ;
    skos:inScheme kauno: ;
    skos:note "Termiä voi käyttää myös sellaisista sävellyksistä, jotka on sävelletty ja tekstitetty maakuntalauluiksi, mutta jotka eivät ole tätä asemaa historiallisesti saaneet. Useimmissa maakunnissa on yksi kiistaton maakuntalaulu, jonka rinnalla voi esiintyä kilpailevia sävelmiä."@fi,
        "Begreppet kan användas också om sådana kompositioner som har komponerats och textats som landskapssånger, men som inte historiskt fått den ställningen. I de flesta landskap finns det en obestridlig landskapssång, vid vars sida konkurrerande melodier också kan förekomma."@sv ;
    skos:prefLabel "provincial anthems"@en,
        "maakuntalaulut"@fi,
        "landskapssånger"@sv ;
    skos:related yso:p30037 ;
    yso-meta:singularPrefLabel "provincial anthem"@en,
        "maakuntalaulu"@fi,
        "landskapssång"@sv .

