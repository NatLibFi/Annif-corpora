yso:p6279 a skos:Concept,
        yso-meta:Concept ;
    dc:source "Lähde: Ympäristöterveysohjelma (Maailman terveysjärjestön määritelmä ympäristöterveydestä)"@fi ;
    dct:created "1996-03-12"^^xsd:date ;
    skos:altLabel "miljö och hälsa"@sv ;
    skos:broader yso:p28822 ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85044173>,
        <http://www.wikidata.org/entity/Q932068>,
        allars:Y22822,
        ysa:Y109616 ;
    skos:inScheme kauno: ;
    skos:narrower yso:p28408 ;
    skos:note "Ympäristöterveyteen sisältyvät ne ihmisen terveyden ja sairauden näkökulmat, joihin ympäristötekijät vaikuttavat. Sillä tarkoitetaan myös sitä teoriaa ja niitä käytännön toimenpiteitä, joilla arvioidaan ja hallitaan ympäristössä olevia terveyteen vaikuttavia tekijöitä."@fi,
        "Inbegriper de aspekter på människans hälsa och sjukdom som miljöfaktorer påverkar. Avser också den teori och de praktiska åtgärder, med vilka man utvärderar och kontrollerar hälsopåverkande faktorer i miljön."@sv ;
    skos:prefLabel "environmental health"@en,
        "ympäristöterveys"@fi,
        "birasdearvvašvuohta"@se,
        "miljöhälsa"@sv ;
    skos:related yso:p1105,
        yso:p39575 .

