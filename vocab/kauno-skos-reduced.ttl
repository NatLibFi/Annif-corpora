    skos:closeMatch allars:Y51809,
        ysa:Y214817 ;
    skos:definition "Orkesterille sävelletyistä teoksista koostettua harjoitteluaineistoa, joka voi esiintyä  nuottina, videona tai \"music-minus-one\" -tyyppisenä äänitteenä. Orkesteriharjoitukset ovat  eri soittimille tarkoitettuja orkesterimusiikkiteosten katkelmia ja soolo-osuuksia yksittäisinä  ääninä. Tunnettuja orkesteriharjoitusjulkaisuja ovat Orchesterstudien, Orchester Probe-Spiele ja Orchestral excerpts."@fi ;
    skos:hiddenLabel "orkesterövning"@sv ;
    skos:inScheme kauno:deprecatedconceptscheme ;
    skos:prefLabel "orkesteriharjoitukset"@fi,
        "orkesterövningar"@sv ;
    skos:scopeNote "deprecated on 2019-05-15" ;
    skos:topConceptOf kauno:deprecatedconceptscheme ;
    ysometa:deprecatedHasThematicGroup yso:p26571 ;
    yso-meta:singularPrefLabel "orkesterövning"@sv .

yso:p30086 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-07"^^xsd:date ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh85012927>,
        <http://www.wikidata.org/entity/Q212112>,
        allars:Y51880,
        ysa:Y214415 ;
    skos:definition "Alkuperältään italialainen korostetun laulullinen taidemusiikin, erityisesti oopperan, esittämistapa, jolle on ominaista legaton käyttö laulajan koko äänialan laajuudelta sekä varsinkin ylärekisterin ketteryys ja ilmavuus. Bel canton tyylillisenä vastakohtana pidetään saksalaistyyppistä, voimakkaammin deklamoivaa, tunnepitoisempaa ja tekstin tulkintaan paneutuvaa laulutapaa."@fi,
        "Ursprungligen italiensk sångstil inriktad på vacker tonbildning inom konstmusik, särskilt opera."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "bel canto"@en,
        "bel canto"@fi,
        "bel canto"@se,
        "bel canto"@sv .

yso:p30108 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-08"^^xsd:date ;
    skos:altLabel "latinorock"@fi,
        "latinorock"@sv ;
    skos:closeMatch <http://www.wikidata.org/entity/Q185162>,
        allars:Y51908,
        ysa:Y214541 ;
    skos:definition "1960-luvulla Yhdysvalloissa kehittynyt rock-musiikin tyyli, johon on otettu vaikutteita latinalaisamerikkalaisesta tanssimusiikista. Tunnettu tyylin edustaja on Santana."@fi,
        "Rockmusikstil utvecklad på 1960-talet i USA, med influenser av latinamerikansk dansmusik. En känd företrädare av stilen är Santana."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "Latin rock"@en,
        "latin rock"@fi,
        "latin rock"@se,
        "latin rock"@sv .

yso:p30129 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1996-02-08"^^xsd:date ;
    skos:altLabel "psychedelic music"@en,
        "psykedeelinen musiikki"@fi,
        "psykedelalaš musihkka"@se,
        "psykedelisk musik"@sv ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh95010207>,
        <http://www.wikidata.org/entity/Q206159>,
        allars:Y51867,
        ysa:Y214618 ;
    skos:definition "Rockin laji, joka kukoisti 1960-luvun lopulta 1970-luvun puoleenväliin. Psykedeeliseen rockiin liittyivät tavallisesti pyrkimykset tietoisuuden tai mielen avartamiseen mm. sointivärikokeiluilla, huumausaineilla (erityisesti LSD) ja itämaisilla uskonnoilla. Psykedeelisellä rockilla oli myös selvät yhteydet sekä folk- että hippiliikkeeseen. Termiä voidaan käyttää myös tyylinmukaisesti myöhemmin tehdyn musiikin yhteydessä."@fi,
        "Rockstil som blomstrade på 1960-1970-talet och som vanligen förknippades med en strävan att öppna sinnet eller medvetandet med klangfärgsexperiment, droger (särskilt LSD) och österländska religioner. Psykedelisk rock hade också anknytning till både folkmusik- och hippierörelsen. Termen kan även användas om senare musik som gjorts i enlighet med stilen."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "psychedelic rock"@en,
        "psykedeelinen rock"@fi,
        "psykedelalaš rock"@se,
        "psykedelisk rock"@sv .

yso:p30143 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-17"^^xsd:date ;
    skos:closeMatch <http://id.loc.gov/authorities/subjects/sh99012468>,
        <http://www.wikidata.org/entity/Q606089>,
        allars:Y51975,
        ysa:Y214661 ;
    skos:definition "Yhdysvalloissa käyttöön otettu nimitys jazzmusiikille, jossa kokoonpanossa oli sellaisia omatekoisia soittimia, kuten pesulauta ja paperilla päällystetty kampa. Nimityksen ottivat käyttöön myös eräät Isossa-Britanniassa 1950-luvulla syntyneet yhtyeet, jotka yhdistivät musiikissaan jazzia, bluesia ja folkia."@fi,
        "Musikgenre med influenser av jazz, blues och folk. Ursprungligen togs benämningen i bruk för ensemblen med hemmagjorda instrument, såsom tvättbräden."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "skiffle"@en,
        "skiffle"@fi,
        "skiffle"@se,
        "skiffle"@sv .

