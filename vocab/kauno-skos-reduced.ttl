yso:p30004 a skos:Concept,
        yso-meta:Concept ;
    dct:created "2005-06-20"^^xsd:date ;
    skos:altLabel "neo soul"@en,
        "nu-soul"@en,
        "neo soul"@fi,
        "nu-soul"@fi,
        "neo soul"@se,
        "neosoul"@sv ;
    skos:broadMatch <http://id.loc.gov/authorities/subjects/sh85125359> ;
    skos:closeMatch allars:Y51985,
        ysa:Y214593 ;
    skos:definition "1990-luvulla muotoutunut soul-musiikista vaikutteita saanut populaarimusiikin laji, jossa on tunnusomaisena piirteenä perinteisten soittimien käyttö. Tyypillisiä tyylin edustajia ovat Erykah Badu, Lauryn Hill, Angie Stone ja Raphael Saadiq."@fi,
        "Populärmusikalisk genre som formats på 1990-talet med intryck av soulmusik, och som typiskt inkluderar traditionella instrument. Företrädare av stilen är t.ex. Erykah Badu, Lauryn Hill, Angie Stone och Raphael Saadiq."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "neo-soul"@en,
        "neo-soul"@fi,
        "neo-soul"@se,
        "neo-soul"@sv ;
    skos:related yso:p12375,
        yso:p29894 .

