kauno:p1017 a skos:Concept,
        kaunometa:Concept ;
    dc:source "Verkko-Kaunokki"@fi,
        "Webb-Bella"@sv ;
    rdfs:comment "Viisisäkeinen pilailuruno, jonka ensimmäinen säe päättyy tavallisesti paikannimeen ja jonka viimeinen säe sisältää yllättävän, usein kaksimielisen kärjistyksen."@fi,
        "Femstrofig gyckeldikt vars första strof vanligtvis slutar med ett ortsnamn och i vars sista strof finns en överraskande ofta tvetydig tillspetsning."@sv ;
    skos:inScheme kauno: ;
    skos:prefLabel "limerikit"@fi,
        "limerickar"@sv ;
    kaunometa:facet kaunometa:section_3 .

