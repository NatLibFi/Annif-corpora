        allars:Y24896,
        ysa:Y107364 ;
    skos:definition "Musiikkityyli, jossa solisti tai solistit esittävät puhelaulutyyliin sanoituksia painottaen ja tavuttaen sanoja rytmikkäästi. Sanoitukset sisältävät usein riimejä ja kappaleiden musiikkitaustoissa on jonkinlaisen tasainen rumpurytmi."@fi,
        "Musikstil i vilken en eller flera solister framför texter med talsångsprägel med rytmisk betoning och avstavning. Texterna innehåller ofta rim och i låtarnas musikaliska bakgrund finns någon slags jämn trumrytm."@sv ;
    skos:inScheme kauno: ;
    skos:narrower yso:p39748 ;
    skos:prefLabel "rap music"@en,
        "rap"@fi,
