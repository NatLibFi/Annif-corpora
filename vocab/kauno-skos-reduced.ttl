yso:p19639 a skos:Concept,
        yso-meta:Concept ;
    dct:created "1986-09-01"^^xsd:date ;
    skos:altLabel "tilapäispainatteet"@fi,
        "tilapääjulkaisut"@fi,
        "accidenstryck"@sv,
        "efemärt tryck"@sv,
        "tillfällighetstryck"@sv,
        "vardagstryck"@sv ;
    skos:broader yso:p1548 ;
    skos:closeMatch allars:Y26372,
        ysa:Y101970 ;
    skos:definition "Pienpainatteet ovat enimmäkseen käytännön elämään liittyviä, yleensä lyhytaikaiseen käyttöön tarkoitettuja ja ajankohtaisuutensa verrattain nopeasti menettäviä painotuotteita. Julkaisun kuuluminen pienpainatteisiin ei perustu painoksen suuruuteen tai julkaisun fyysiseen kokoon. -- Kansalliskirjasto, vapaakappaletoimisto"@fi,
        "Trycksaker som vanligen relaterar till det praktiska livet, vanligen avsedda för tillfälligt bruk, och som relativt snabbt förlorar sin aktualitet. Trycksakens fysiska storlek eller upplagans storlek inverkar inte på huruvida den klassificeras som småtryck eller inte."@sv ;
    skos:hiddenLabel "pienpainate"@fi,
        "tilapäispainate"@fi,
        "tilapääjulkaisu"@fi ;
    skos:inScheme kauno: ;
    skos:narrower yso:p10805,
        yso:p16422,
        yso:p18626,
        yso:p18786,
        yso:p19712,
        yso:p25907,
        yso:p28147 ;
    skos:prefLabel "ephemera (publications)"@en,
        "pienpainatteet"@fi,
        "småtryck"@sv ;
    skos:related yso:p13610,
        yso:p13715,
        yso:p19230,
        yso:p2045,
        yso:p2279,
        yso:p4097,
        yso:p6081,
